{
  "name": "agentic-oauth-bot",
  "version": "1.0.0",
  "description": "Autonomous OAuth agent — machine-to-machine identity, signs its own requests, connects to authorized-to-act via MCP",
  "main": "dist/main.js",
  "scripts": {
    "build":       "tsc",
    "start":       "node dist/main.js",
    "dev":         "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint":        "eslint . --ext .ts --max-warnings 0",
    "test":        "jest --runInBand",
    "keygen":      "ts-node scripts/rotateKeys.ts",
    "register":    "bash scripts/registerAgent.sh",
    "test:flow":   "ts-node scripts/testFlow.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk":         "0.20.9",
    "@modelcontextprotocol/sdk": "0.5.0",
    "@slack/web-api":            "7.3.4",
    "axios":                     "1.14.0",
    "dotenv":                    "16.4.5",
    "express":                   "4.19.2",
    "googleapis":                "140.0.1",
    "jose":                      "5.6.3",
    "node-cache":                "5.1.2",
    "uuid":                      "10.0.0",
    "winston":                   "3.13.0",
    "zod":                       "3.23.8"
  },
  "devDependencies": {
    "@types/express":  "4.17.21",
    "@types/jest":     "29.5.12",
    "@types/node":     "20.14.0",
    "@types/uuid":     "10.0.0",
    "eslint":          "8.57.1",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "@typescript-eslint/parser":        "7.13.0",
    "jest":            "29.7.0",
    "ts-jest":         "29.1.5",
    "ts-node":         "10.9.2",
    "ts-node-dev":     "2.0.0",
    "typescript":      "5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": ["./tests/setup.ts"],
    "testMatch": ["**/tests/**/*.test.ts"]
  },
  "engines": { "node": ">=18.0.0" }
}
