{
  "name": "peaq-forge",
  "version": "1.0.0",
  "description": "peaq Network Dev Console — Production Modular. EVM, Foundry, ink!, Substrate, DID, mNFT, Storage, RBAC",
  "main": "server.js",
  "scripts": {
    "start":         "NODE_ENV=production node server.js",
    "dev":           "NODE_ENV=development nodemon server.js",
    "stop":          "bash scripts/stop.sh",
    "restart":       "bash scripts/restart.sh",
    "check":         "bash scripts/check-tools.sh",
    "install:tools": "bash scripts/install.sh",
    "pm2:start":     "pm2 start ecosystem.config.js --env production",
    "pm2:stop":      "pm2 stop peaq-forge",
    "pm2:restart":   "pm2 restart peaq-forge",
    "pm2:reload":    "pm2 reload peaq-forge",
    "pm2:logs":      "pm2 logs peaq-forge",
    "pm2:status":    "pm2 status",
    "pm2:save":      "pm2 save && pm2 startup",
    "pm2:setup":     "bash scripts/pm2-setup.sh",
    "backup":        "bash scripts/backup.sh",
    "test":          "node --test 'tests/**/*.test.js'",
    "test:unit":     "node --test 'tests/unit/*.test.js'",
    "test:integration": "node --test 'tests/integration/*.test.js'",
    "audit":         "npm audit --audit-level=high",
    "test:server":   "node -e \"const h=require('http');h.get('http://127.0.0.1:3048',r=>{console.log('OK',r.statusCode);process.exit(0)}).on('error',()=>{console.error('NOT RUNNING');process.exit(1)})\""
  },
  "dependencies": {
    "express":               "5.2.1",
    "cors":                  "2.8.5",
    "ws":                    "8.19.0",
    "@peaq-network/sdk":     "0.9.2",
    "@polkadot/api":         "16.5.4",
    "@polkadot/keyring":     "13.4.3",
    "@polkadot/util":        "13.4.3",
    "@polkadot/util-crypto": "13.4.3",
    "dotenv":                "16.4.7",
    "helmet":                "8.1.0",
    "express-rate-limit":    "8.3.0",
    "winston":               "3.17.0",
    "joi":                   "17.13.3",
    "express-async-errors":  "3.1.1"
  },
  "devDependencies": {
    "nodemon": "3.1.9",
    "pm2":     "5.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
