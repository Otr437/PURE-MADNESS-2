{
  "chain": "Zcash",
  "install": {
    "ubuntu_deps": "sudo apt-get install build-essential pkg-config libc6-dev m4 g++-multilib autoconf libtool ncurses-dev unzip git python3 python3-zmq zlib1g-dev curl bsdmainutils automake libtinfo5",
    "clone": "git clone https://github.com/zcash/zcash.git && cd zcash",
    "checkout_latest": "git checkout v6.11.0",
    "fetch_params": "./zcutil/fetch-params.sh",
    "build": "./zcutil/build.sh -j$(nproc)",
    "install_binaries": "cd src && sudo install -sv zcashd zcash-cli /usr/local/bin/",
    "create_conf": "mkdir -p ~/.zcash && touch ~/.zcash/zcash.conf",
    "zebra_rust_install": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
    "zebra_clone": "git clone https://github.com/ZcashFoundation/zebra.git && cd zebra",
    "zebra_build": "cargo build --release",
    "zebra_run": "./target/release/zebrad start",
    "lightwalletd_clone": "git clone https://github.com/zcash/lightwalletd.git && cd lightwalletd",
    "lightwalletd_build": "go build -o lightwalletd main.go",
    "lightwalletd_run": "./lightwalletd --grpc-bind-addr 0.0.0.0:9067 --zcash-conf-path ~/.zcash/zcash.conf --log-file /tmp/lwd.log",
    "pip_zcash": "pip install python-zcash"
  },
  "node": {
    "start": "./src/zcashd",
    "start_daemon": "./src/zcashd --daemon",
    "start_testnet": "./src/zcashd --testnet --daemon",
    "stop": "zcash-cli stop",
    "check_version": "zcash-cli --version",
    "check_sync": "zcash-cli getblockchaininfo"
  },
  "zcash_cli": {
    "help": "zcash-cli help",
    "help_command": "zcash-cli help z_sendmany",
    "getinfo": "zcash-cli getinfo",
    "getblockchaininfo": "zcash-cli getblockchaininfo",
    "getblockcount": "zcash-cli getblockcount",
    "getblockhash": "zcash-cli getblockhash BLOCK_HEIGHT",
    "getblock": "zcash-cli getblock BLOCK_HASH",
    "getblock_verbose": "zcash-cli getblock BLOCK_HASH 2",
    "getbestblockhash": "zcash-cli getbestblockhash",
    "getdifficulty": "zcash-cli getdifficulty",
    "getnewaddress": "zcash-cli getnewaddress",
    "z_getnewaddress": "zcash-cli z_getnewaddress",
    "z_getnewaddress_sapling": "zcash-cli z_getnewaddress sapling",
    "z_getnewaddress_orchard": "zcash-cli z_getnewaddress orchard",
    "z_getnewaddress_unified": "zcash-cli z_getnewaddress unified",
    "z_listaddresses": "zcash-cli z_listaddresses",
    "getaddressesbyaccount": "zcash-cli getaddressesbyaccount ''",
    "getbalance": "zcash-cli getbalance",
    "z_getbalance": "zcash-cli z_getbalance YOUR_Z_ADDRESS",
    "z_gettotalbalance": "zcash-cli z_gettotalbalance",
    "listunspent": "zcash-cli listunspent",
    "z_listunspent": "zcash-cli z_listunspent",
    "sendtoaddress": "zcash-cli sendtoaddress T_ADDRESS AMOUNT",
    "z_sendmany_shielded": "zcash-cli z_sendmany FROM_ZADDR '[{\"address\":\"TO_ZADDR\",\"amount\":0.01}]'",
    "z_sendmany_transparent_to_shielded": "zcash-cli z_sendmany FROM_TADDR '[{\"address\":\"TO_ZADDR\",\"amount\":0.01}]'",
    "z_sendmany_with_memo": "zcash-cli z_sendmany FROM_ZADDR '[{\"address\":\"TO_ZADDR\",\"amount\":0.01,\"memo\":\"48656c6c6f\"}]'",
    "z_sendmany_multi_output": "zcash-cli z_sendmany FROM_ZADDR '[{\"address\":\"ZADDR1\",\"amount\":0.01},{\"address\":\"ZADDR2\",\"amount\":0.02}]'",
    "z_shieldcoinbase": "zcash-cli z_shieldcoinbase FROM_TADDR TO_ZADDR",
    "z_shieldcoinbase_all": "zcash-cli z_shieldcoinbase '*' TO_ZADDR",
    "z_mergetoaddress": "zcash-cli z_mergetoaddress '[\"ANY_SPROUT\",\"ANY_SAPLING\"]' TO_ZADDR",
    "z_getoperationstatus": "zcash-cli z_getoperationstatus '[\"OPERATION_ID\"]'",
    "z_getoperationresult": "zcash-cli z_getoperationresult '[\"OPERATION_ID\"]'",
    "z_listoperationids": "zcash-cli z_listoperationids",
    "z_listreceivedbyaddress": "zcash-cli z_listreceivedbyaddress YOUR_Z_ADDRESS",
    "z_viewtransaction": "zcash-cli z_viewtransaction TX_HASH",
    "z_exportkey": "zcash-cli z_exportkey YOUR_Z_ADDRESS",
    "z_importkey": "zcash-cli z_importkey SPENDING_KEY",
    "z_exportwallet": "zcash-cli z_exportwallet /path/to/wallet-backup.txt",
    "z_importwallet": "zcash-cli z_importwallet /path/to/wallet-backup.txt",
    "z_exportviewingkey": "zcash-cli z_exportviewingkey YOUR_Z_ADDRESS",
    "z_importviewingkey": "zcash-cli z_importviewingkey VIEWING_KEY",
    "getrawtransaction": "zcash-cli getrawtransaction TX_HASH 1",
    "sendrawtransaction": "zcash-cli sendrawtransaction SIGNED_TX_HEX",
    "decoderawtransaction": "zcash-cli decoderawtransaction RAW_TX_HEX",
    "getrawmempool": "zcash-cli getrawmempool",
    "getmempoolinfo": "zcash-cli getmempoolinfo",
    "validateaddress": "zcash-cli validateaddress ZEC_ADDRESS",
    "z_validateaddress": "zcash-cli z_validateaddress Z_ADDRESS",
    "getnetworkinfo": "zcash-cli getnetworkinfo",
    "getpeerinfo": "zcash-cli getpeerinfo",
    "getconnectioncount": "zcash-cli getconnectioncount",
    "getmininginfo": "zcash-cli getmininginfo",
    "getnetworksolps": "zcash-cli getnetworksolps",
    "backupwallet": "zcash-cli backupwallet /path/to/backup.dat",
    "dumpwallet": "zcash-cli dumpwallet /path/to/dump.txt",
    "importwallet": "zcash-cli importwallet /path/to/dump.txt",
    "dumpprivkey": "zcash-cli dumpprivkey T_ADDRESS",
    "importprivkey": "zcash-cli importprivkey PRIVATE_KEY",
    "keypoolrefill": "zcash-cli keypoolrefill",
    "listlockunspent": "zcash-cli listlockunspent",
    "listreceivedbyaddress": "zcash-cli listreceivedbyaddress 1 true",
    "listtransactions": "zcash-cli listtransactions",
    "gettransaction": "zcash-cli gettransaction TX_HASH",
    "estimatefee": "zcash-cli estimatefee 6",
    "settxfee": "zcash-cli settxfee 0.0001"
  },
  "curl": {
    "getblockchaininfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockchaininfo\",\"params\":[]}'",
    "getblockcount": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockcount\",\"params\":[]}'",
    "getbestblockhash": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getbestblockhash\",\"params\":[]}'",
    "getblockhash": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockhash\",\"params\":[BLOCK_HEIGHT]}'",
    "getblock": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblock\",\"params\":[\"BLOCK_HASH\"]}'",
    "getblock_verbose": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblock\",\"params\":[\"BLOCK_HASH\",2]}'",
    "getbalance": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getbalance\",\"params\":[]}'",
    "z_getbalance": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_getbalance\",\"params\":[\"YOUR_Z_ADDRESS\"]}'",
    "z_gettotalbalance": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_gettotalbalance\",\"params\":[]}'",
    "z_getnewaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_getnewaddress\",\"params\":[]}'",
    "z_getnewaddress_sapling": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_getnewaddress\",\"params\":[\"sapling\"]}'",
    "z_listaddresses": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_listaddresses\",\"params\":[]}'",
    "z_sendmany": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_sendmany\",\"params\":[\"FROM_ADDRESS\",[{\"address\":\"TO_ADDRESS\",\"amount\":0.01}]]}'",
    "z_shieldcoinbase": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_shieldcoinbase\",\"params\":[\"FROM_TADDR\",\"TO_ZADDR\"]}'",
    "z_getoperationstatus": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_getoperationstatus\",\"params\":[[\"OPERATION_ID\"]]}'",
    "z_getoperationresult": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_getoperationresult\",\"params\":[[\"OPERATION_ID\"]]}'",
    "z_listoperationids": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_listoperationids\",\"params\":[]}'",
    "z_listreceivedbyaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_listreceivedbyaddress\",\"params\":[\"YOUR_Z_ADDRESS\"]}'",
    "getrawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getrawtransaction\",\"params\":[\"TX_HASH\",1]}'",
    "sendrawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"sendrawtransaction\",\"params\":[\"SIGNED_TX_HEX\"]}'",
    "decoderawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"decoderawtransaction\",\"params\":[\"RAW_TX_HEX\"]}'",
    "getrawmempool": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getrawmempool\",\"params\":[]}'",
    "getmempoolinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getmempoolinfo\",\"params\":[]}'",
    "validateaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"validateaddress\",\"params\":[\"ZEC_ADDRESS\"]}'",
    "z_validateaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"z_validateaddress\",\"params\":[\"Z_ADDRESS\"]}'",
    "getnetworkinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getnetworkinfo\",\"params\":[]}'",
    "getpeerinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getpeerinfo\",\"params\":[]}'",
    "getmininginfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getmininginfo\",\"params\":[]}'",
    "getnetworksolps": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getnetworksolps\",\"params\":[]}'",
    "estimatefee": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8232/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"estimatefee\",\"params\":[6]}'"
  }
}
