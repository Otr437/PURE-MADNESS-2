    { "name": "PublicNode WSS", "url": "wss://ethereum-rpc.publicnode.com" },
    { "name": "Flashbots Protect", "url": "https://rpc.flashbots.net" },
    { "name": "Flashbots Fast", "url": "https://rpc.flashbots.net/fast" },
    { "name": "MEV Blocker", "url": "https://rpc.mevblocker.io" },
    { "name": "1RPC", "url": "https://1rpc.io/eth" },
    { "name": "DRPC", "url": "https://eth.drpc.org" },
    { "name": "LlamaNodes", "url": "https://eth.llamarpc.com" },
    { "name": "Ankr", "url": "https://rpc.ankr.com/eth" },
    { "name": "Meowrpc", "url": "https://eth.meowrpc.com" }
