{
  "chain": "Berachain",
  "install": {
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash",
    "foundry_update": "foundryup",
    "forge_init": "forge init my-bera-project",
    "forge_install_oz": "forge install OpenZeppelin/openzeppelin-contracts --no-commit",
    "hardhat_setup": "npm init -y && npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv",
    "hardhat_init": "npx hardhat init",
    "npm_ethers": "npm install ethers",
    "npm_viem": "npm install viem",
    "npm_web3": "npm install web3",
    "pip_web3": "pip install web3 eth-account python-dotenv",
    "wscat": "npm install -g wscat"
  },
  "hardhat": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test_fork": "npx hardhat test --network hardhat",
    "deploy_mainnet": "npx hardhat run scripts/deploy.js --network berachain",
    "deploy_testnet": "npx hardhat run scripts/deploy.js --network bepolia",
    "verify_berascan": "npx hardhat verify --network berachain CONTRACT_ADDRESS",
    "ignition_mainnet": "npx hardhat ignition deploy ignition/modules/Deploy.ts --network berachain",
    "ignition_testnet": "npx hardhat ignition deploy ignition/modules/Deploy.ts --network bepolia",
    "clean": "npx hardhat clean",
    "node": "npx hardhat node",
    "coverage": "npx hardhat coverage",
    "flatten": "npx hardhat flatten contracts/Contract.sol"
  },
  "forge": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test_fork_mainnet": "forge test --fork-url https://rpc.berachain.com -vvv",
    "test_fork_testnet": "forge test --fork-url https://bepolia.rpc.berachain.com -vvv",
    "test_match": "forge test --match-test testFunctionName -vvv",
    "deploy_mainnet": "forge script script/Deploy.s.sol --rpc-url https://rpc.berachain.com --broadcast --account MyAccount",
    "deploy_testnet": "forge script script/Deploy.s.sol --rpc-url https://bepolia.rpc.berachain.com --broadcast --account MyAccount",
    "deploy_verbose": "forge script script/Deploy.s.sol --rpc-url https://rpc.berachain.com --broadcast --account MyAccount -vvvv",
    "verify_mainnet": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 80094 --etherscan-api-key YOUR_BERASCAN_KEY",
    "verify_testnet": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 80069 --etherscan-api-key YOUR_KEY",
    "create_mainnet": "forge create src/Contract.sol:Contract --rpc-url https://rpc.berachain.com --account MyAccount --broadcast",
    "install_solmate": "forge install transmissions11/solmate --no-commit",
    "snapshot": "forge snapshot",
    "coverage": "forge coverage",
    "flatten": "forge flatten src/Contract.sol",
    "inspect_abi": "forge inspect src/Contract.sol:Contract abi",
    "inspect_bytecode": "forge inspect src/Contract.sol:Contract bytecode",
    "check_broadcast": "cat broadcast/Deploy.s.sol/80094/run-latest.json"
  },
  "cast": {
    "wallet_import": "cast wallet import MyAccount --interactive",
    "wallet_new": "cast wallet new",
    "wallet_address": "cast wallet address --account MyAccount",
    "block_number": "cast block-number --rpc-url https://rpc.berachain.com",
    "block": "cast block latest --rpc-url https://rpc.berachain.com",
    "chain_id": "cast chain-id --rpc-url https://rpc.berachain.com",
    "gas_price": "cast gas-price --rpc-url https://rpc.berachain.com",
    "base_fee": "cast base-fee latest --rpc-url https://rpc.berachain.com",
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url https://rpc.berachain.com",
    "get_balance_ether": "cast balance YOUR_ADDRESS --ether --rpc-url https://rpc.berachain.com",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url https://rpc.berachain.com",
    "get_code": "cast code CONTRACT_ADDRESS --rpc-url https://rpc.berachain.com",
    "get_storage": "cast storage CONTRACT_ADDRESS SLOT --rpc-url https://rpc.berachain.com",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url https://rpc.berachain.com",
    "call_balanceof": "cast call CONTRACT 'balanceOf(address)(uint256)' YOUR_ADDRESS --rpc-url https://rpc.berachain.com",
    "send_tx": "cast send TO_ADDRESS --value 0.01ether --rpc-url https://rpc.berachain.com --account MyAccount",
    "send_contract": "cast send CONTRACT 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://rpc.berachain.com --account MyAccount",
    "send_with_gas": "cast send TO_ADDRESS --value 0.01ether --rpc-url https://rpc.berachain.com --account MyAccount --gas-limit 21000",
    "get_tx": "cast tx TX_HASH --rpc-url https://rpc.berachain.com",
    "get_receipt": "cast receipt TX_HASH --rpc-url https://rpc.berachain.com",
    "estimate_gas": "cast estimate TO_ADDRESS 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://rpc.berachain.com",
    "get_logs": "cast logs --address CONTRACT_ADDRESS --rpc-url https://rpc.berachain.com",
    "decode_calldata": "cast 4byte-decode 0xCALLDATA_HEX",
    "decode_event": "cast 4byte-event 0xEVENT_TOPIC",
    "abi_encode": "cast abi-encode 'transfer(address,uint256)' RECIPIENT AMOUNT",
    "abi_decode": "cast abi-decode 'transfer(address,uint256)' CALLDATA_HEX",
    "keccak": "cast keccak 'transfer(address,uint256)'",
    "to_wei": "cast to-wei 1 ether",
    "from_wei": "cast from-wei 1000000000000000000",
    "compute_address": "cast compute-address YOUR_ADDRESS --nonce NONCE",
    "access_list": "cast access-list CONTRACT 'functionName()' --rpc-url https://rpc.berachain.com",
    "testnet_balance": "cast balance YOUR_ADDRESS --rpc-url https://bepolia.rpc.berachain.com",
    "testnet_block": "cast block-number --rpc-url https://bepolia.rpc.berachain.com"
  },
  "anvil": {
    "fork_mainnet": "anvil --fork-url https://rpc.berachain.com",
    "fork_testnet": "anvil --fork-url https://bepolia.rpc.berachain.com",
    "fork_at_block": "anvil --fork-url https://rpc.berachain.com --fork-block-number BLOCK_NUMBER",
    "set_balance": "cast rpc anvil_setBalance 0xYOUR_ADDRESS 0xDE0B6B3A7640000 --rpc-url http://127.0.0.1:8545",
    "impersonate": "cast rpc anvil_impersonateAccount 0xADDRESS --rpc-url http://127.0.0.1:8545",
    "stop_impersonate": "cast rpc anvil_stopImpersonatingAccount 0xADDRESS --rpc-url http://127.0.0.1:8545",
    "mine": "cast rpc anvil_mine 1 --rpc-url http://127.0.0.1:8545",
    "snapshot": "cast rpc evm_snapshot --rpc-url http://127.0.0.1:8545",
    "revert": "cast rpc evm_revert SNAPSHOT_ID --rpc-url http://127.0.0.1:8545",
    "set_next_timestamp": "cast rpc evm_setNextBlockTimestamp UNIX_TIMESTAMP --rpc-url http://127.0.0.1:8545"
  },
  "curl": {
    "web3_clientVersion": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "net_listening": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_listening\",\"params\":[],\"id\":1}'",
    "net_peerCount": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_peerCount\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_accounts": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_accounts\",\"params\":[],\"id\":1}'",
    "eth_blockNumber": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount_pending": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"pending\"],\"id\":1}'",
    "eth_getBlockTransactionCountByHash": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockTransactionCountByHash\",\"params\":[\"0xBLOCK_HASH\"],\"id\":1}'",
    "eth_getBlockTransactionCountByNumber": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockTransactionCountByNumber\",\"params\":[\"latest\"],\"id\":1}'",
    "eth_getCode": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_sendRawTransaction": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX_HEX\"],\"id\":1}'",
    "eth_call": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_getBlockByNumber_latest": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByNumber_pending": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"pending\",false],\"id\":1}'",
    "eth_getBlockByNumber_earliest": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"earliest\",false],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionByBlockHashAndIndex": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByBlockHashAndIndex\",\"params\":[\"0xBLOCK_HASH\",\"0x0\"],\"id\":1}'",
    "eth_getTransactionByBlockNumberAndIndex": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByBlockNumberAndIndex\",\"params\":[\"latest\",\"0x0\"],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_newFilter": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_newPendingTransactionFilter": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newPendingTransactionFilter\",\"params\":[],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getFilterLogs": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterLogs\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"0x0\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_feeHistory": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_createAccessList": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_createAccessList\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC\"},\"latest\"],\"id\":1}'",
    "eth_getProof": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getProof\",\"params\":[\"0xADDRESS\",[\"0x0\"],\"latest\"],\"id\":1}'",
    "debug_traceTransaction": "curl -X POST https://rpc.ankr.com/berachain -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"debug_traceTransaction\",\"params\":[\"0xTX_HASH\",{}],\"id\":1}'",
    "debug_traceTransaction_calltracer": "curl -X POST https://rpc.ankr.com/berachain -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"debug_traceTransaction\",\"params\":[\"0xTX_HASH\",{\"tracer\":\"callTracer\"}],\"id\":1}'",
    "debug_traceBlockByNumber": "curl -X POST https://rpc.ankr.com/berachain -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"debug_traceBlockByNumber\",\"params\":[\"latest\",{}],\"id\":1}'",
    "txpool_status": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_status\",\"params\":[],\"id\":1}'",
    "txpool_inspect": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_inspect\",\"params\":[],\"id\":1}'",
    "txpool_content": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_content\",\"params\":[],\"id\":1}'",
    "eth_subscribe_newHeads": "wscat -c wss://rpc.berachain.com -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "eth_subscribe_logs": "wscat -c wss://rpc.berachain.com -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"logs\",{\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_subscribe_pendingTx": "wscat -c wss://rpc.berachain.com -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newPendingTransactions\"],\"id\":1}'",
    "eth_unsubscribe": "wscat -c wss://rpc.berachain.com -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_unsubscribe\",\"params\":[\"0xSUB_ID\"],\"id\":1}'",
    "testnet_block_number": "curl -X POST https://bepolia.rpc.berachain.com -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "batch_request": "curl -X POST https://rpc.berachain.com -H 'Content-Type: application/json' --data '[{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":3},{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":4}]'"
  }
}
