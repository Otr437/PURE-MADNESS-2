{
  "chain": "Peaq",
  "install": {
    "rust": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
    "rust_wasm_target": "rustup target add wasm32-unknown-unknown",
    "rust_nightly": "rustup update nightly && rustup target add wasm32-unknown-unknown --toolchain nightly",
    "linux_deps": "sudo apt-get install -y git clang curl libssl-dev llvm libudev-dev make protobuf-compiler pkg-config",
    "npm_polkadot_api": "npm install @polkadot/api",
    "npm_polkadot_api_cli": "npm install -g @polkadot/api-cli",
    "npm_polkadot_keyring": "npm install @polkadot/keyring",
    "npm_polkadot_util": "npm install @polkadot/util @polkadot/util-crypto",
    "npm_polkadot_extension": "npm install @polkadot/extension-dapp",
    "npm_ethers": "npm install ethers",
    "npm_viem": "npm install viem",
    "npm_hardhat": "npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv",
    "pip_substrate": "pip install substrate-interface",
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash && foundryup",
    "clone_peaq_node": "git clone https://github.com/peaqnetwork/peaq-network-node.git && cd peaq-network-node",
    "build_peaq_node": "cargo build --release",
    "clone_peaq_did": "git clone https://github.com/peaqnetwork/peaq-did.git"
  },
  "hardhat": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy_mainnet": "npx hardhat run scripts/deploy.js --network peaq",
    "deploy_testnet": "npx hardhat run scripts/deploy.js --network agung",
    "verify": "npx hardhat verify --network peaq CONTRACT_ADDRESS",
    "node_local": "npx hardhat node",
    "clean": "npx hardhat clean"
  },
  "forge": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test_fork": "forge test --fork-url https://peaq.api.onfinality.io/public -vvv",
    "deploy_mainnet": "forge script script/Deploy.s.sol --rpc-url https://peaq.api.onfinality.io/public --broadcast --account MyAccount",
    "deploy_testnet": "forge script script/Deploy.s.sol --rpc-url https://rpcpc1-qa.agung.peaq.network --broadcast --account MyAccount",
    "verify": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 3338",
    "install_oz": "forge install OpenZeppelin/openzeppelin-contracts --no-commit"
  },
  "cast": {
    "wallet_import": "cast wallet import MyAccount --interactive",
    "block_number": "cast block-number --rpc-url https://peaq.api.onfinality.io/public",
    "chain_id": "cast chain-id --rpc-url https://peaq.api.onfinality.io/public",
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url https://peaq.api.onfinality.io/public",
    "get_balance_ether": "cast balance YOUR_ADDRESS --ether --rpc-url https://peaq.api.onfinality.io/public",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url https://peaq.api.onfinality.io/public",
    "gas_price": "cast gas-price --rpc-url https://peaq.api.onfinality.io/public",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url https://peaq.api.onfinality.io/public",
    "send_tx": "cast send TO_ADDRESS --value 0.01ether --rpc-url https://peaq.api.onfinality.io/public --account MyAccount",
    "get_receipt": "cast receipt TX_HASH --rpc-url https://peaq.api.onfinality.io/public",
    "testnet_balance": "cast balance YOUR_ADDRESS --rpc-url https://rpcpc1-qa.agung.peaq.network"
  },
  "polkadot_api_cli": {
    "get_chain": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc system chain",
    "get_version": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc system version",
    "get_health": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc system health",
    "get_block_header": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc chain getHeader",
    "get_finalized_head": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc chain getFinalizedHead",
    "get_block": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc chain getBlock",
    "get_account_info": "npx @polkadot/api-cli --ws wss://wss.peaq.network query system account YOUR_SS58_ADDRESS",
    "get_events": "npx @polkadot/api-cli --ws wss://wss.peaq.network query system events",
    "get_block_hash": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc chain getBlockHash BLOCK_NUMBER",
    "get_runtime_version": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc state getRuntimeVersion",
    "get_metadata": "npx @polkadot/api-cli --ws wss://wss.peaq.network rpc state getMetadata",
    "send_transfer": "npx @polkadot/api-cli --ws wss://wss.peaq.network --seed 'YOUR SEED PHRASE' tx balances transferAllowDeath RECIPIENT_ADDRESS AMOUNT_PLANCK",
    "query_validators": "npx @polkadot/api-cli --ws wss://wss.peaq.network query session validators",
    "query_era": "npx @polkadot/api-cli --ws wss://wss.peaq.network query staking currentEra",
    "agung_chain": "npx @polkadot/api-cli --ws wss://wss-async.agung.peaq.network rpc system chain",
    "agung_block": "npx @polkadot/api-cli --ws wss://wss-async.agung.peaq.network rpc chain getHeader"
  },
  "evm_curl": {
    "web3_clientVersion": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_blockNumber": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getCode": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_sendRawTransaction": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX_HEX\"],\"id\":1}'",
    "eth_call": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_getBlockByNumber": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newFilter": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_feeHistory": "curl -X POST https://peaq.api.onfinality.io/public -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_subscribe_newHeads": "wscat -c wss://peaq.api.onfinality.io/public-ws -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "eth_subscribe_logs": "wscat -c wss://peaq.api.onfinality.io/public-ws -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"logs\",{\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "testnet_block_number": "curl -X POST https://rpcpc1-qa.agung.peaq.network -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "drpc_block_number": "curl -X POST https://peaq.drpc.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'"
  }
}
