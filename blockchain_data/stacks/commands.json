{
  "chain": "Stacks",
  "install": {
    "npm_cli": "npm install -g @stacks/cli",
    "npm_transactions": "npm install @stacks/transactions",
    "npm_network": "npm install @stacks/network",
    "npm_wallet_sdk": "npm install @stacks/wallet-sdk",
    "npm_connect": "npm install @stacks/connect",
    "npm_stacking": "npm install @stacks/stacking",
    "npm_bns": "npm install @stacks/bns",
    "npm_all": "npm install @stacks/transactions @stacks/network @stacks/wallet-sdk @stacks/connect @stacks/stacking",
    "docker_pull": "docker pull blockstack/stacks-blockchain",
    "docker_run": "docker run -d --rm --name stacks-blockchain -p 20443:20443 -p 20444:20444 blockstack/stacks-blockchain /bin/stacks-node start --config /src/stacks-node/Config.toml",
    "docker_logs": "docker logs stacks-blockchain",
    "docker_stop": "docker stop stacks-blockchain",
    "pip_stacks": "pip install stacks-api"
  },
  "stx_cli": {
    "version": "stx --version",
    "help": "stx help",
    "help_all": "stx help all",
    "make_keychain": "stx make_keychain",
    "make_keychain_testnet": "stx make_keychain -t",
    "get_owner_keys": "stx get_owner_keys 'YOUR MNEMONIC PHRASE HERE'",
    "get_app_keys": "stx get_app_keys 'MNEMONIC' GAIA_HUB APP_URL",
    "get_payment_key": "stx get_payment_key 'MNEMONIC'",
    "balance": "stx balance STX_ADDRESS -t https://api.mainnet.hiro.so",
    "balance_testnet": "stx balance STX_ADDRESS -t https://api.testnet.hiro.so",
    "send_tokens": "stx send_tokens RECIPIENT AMOUNT_USTX FEE_USTX NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "send_tokens_testnet": "stx send_tokens RECIPIENT AMOUNT_USTX FEE_USTX NONCE PRIVATE_KEY -t https://api.testnet.hiro.so",
    "deploy_contract": "stx deploy_contract CONTRACT_NAME /path/to/contract.clar FEE_USTX NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "deploy_contract_testnet": "stx deploy_contract CONTRACT_NAME /path/to/contract.clar FEE_USTX NONCE PRIVATE_KEY -t https://api.testnet.hiro.so",
    "call_contract": "stx call_contract_func CONTRACT_ADDRESS CONTRACT_NAME FUNCTION_NAME FEE_USTX NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "call_read_only": "stx call_read_only_contract_func CONTRACT_ADDRESS CONTRACT_NAME FUNCTION_NAME SENDER_ADDRESS -t https://api.mainnet.hiro.so",
    "register_name": "stx register NAME SALT ZONEFILE_HASH ZONEFILE OWNER_ADDRESS FEE NONCE KEY -t https://api.mainnet.hiro.so",
    "lookup_name": "stx lookup NAME -t https://api.mainnet.hiro.so",
    "whois": "stx whois NAME -t https://api.mainnet.hiro.so",
    "profile_sign": "stx profile_sign /path/to/profile.json PRIVATE_KEY",
    "profile_verify": "stx profile_verify /path/to/profile.jwt PUBLIC_KEY",
    "gaia_dump": "stx gaia_dump_bucket USERNAME GAIA_HUB APP_URL ./backups MNEMONIC",
    "gaia_restore": "stx gaia_restore_bucket USERNAME GAIA_HUB APP_URL ./backups MNEMONIC",
    "gaia_getfile": "stx gaia_getfile USERNAME GAIA_HUB APP_URL FILENAME",
    "gaia_putfile": "stx gaia_putfile GAIA_HUB PRIVATE_KEY FILENAME /path/to/local/file"
  },
  "curl": {
    "get_node_info": "curl https://api.mainnet.hiro.so/v2/info",
    "get_node_info_testnet": "curl https://api.testnet.hiro.so/v2/info",
    "get_pox_info": "curl https://api.mainnet.hiro.so/v2/pox",
    "get_neighbors": "curl https://api.mainnet.hiro.so/v2/neighbors",
    "get_block_by_height": "curl https://api.mainnet.hiro.so/extended/v1/block/by_height/BLOCK_HEIGHT",
    "get_block_by_hash": "curl https://api.mainnet.hiro.so/extended/v1/block/BLOCK_HASH",
    "get_latest_block": "curl https://api.mainnet.hiro.so/extended/v1/block",
    "get_blocks_list": "curl 'https://api.mainnet.hiro.so/extended/v1/block?limit=20&offset=0'",
    "get_microblock": "curl https://api.mainnet.hiro.so/extended/v1/microblock/MICROBLOCK_HASH",
    "get_transaction": "curl https://api.mainnet.hiro.so/extended/v1/tx/TX_ID",
    "get_raw_transaction": "curl https://api.mainnet.hiro.so/extended/v1/tx/TX_ID/raw",
    "get_transactions_list": "curl 'https://api.mainnet.hiro.so/extended/v1/tx?limit=20&offset=0'",
    "get_mempool_transactions": "curl https://api.mainnet.hiro.so/extended/v1/tx/mempool",
    "get_dropped_mempool_transactions": "curl https://api.mainnet.hiro.so/extended/v1/tx/mempool/dropped",
    "broadcast_transaction": "curl -X POST https://api.mainnet.hiro.so/v2/transactions -H 'Content-Type: application/octet-stream' --data-binary @signed_tx.bin",
    "get_account_info": "curl https://api.mainnet.hiro.so/v2/accounts/STX_ADDRESS",
    "get_account_info_with_proof": "curl 'https://api.mainnet.hiro.so/v2/accounts/STX_ADDRESS?proof=1'",
    "get_account_balances": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/balances",
    "get_account_stx_balance": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/stx",
    "get_account_transactions": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/transactions",
    "get_account_transactions_with_transfers": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/transactions_with_transfers",
    "get_account_assets": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/assets",
    "get_account_nonces": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/nonces",
    "get_account_mempool_transactions": "curl https://api.mainnet.hiro.so/extended/v1/address/STX_ADDRESS/mempool",
    "get_contract_info": "curl https://api.mainnet.hiro.so/extended/v1/contract/CONTRACT_ADDRESS.CONTRACT_NAME",
    "get_contract_interface": "curl https://api.mainnet.hiro.so/v2/contracts/interface/CONTRACT_ADDRESS/CONTRACT_NAME",
    "get_contract_source": "curl https://api.mainnet.hiro.so/v2/contracts/source/CONTRACT_ADDRESS/CONTRACT_NAME",
    "get_contract_abi": "curl https://api.mainnet.hiro.so/v2/contracts/interface/CONTRACT_ADDRESS/CONTRACT_NAME",
    "call_read_only_function": "curl -X POST https://api.mainnet.hiro.so/v2/contracts/call-read/CONTRACT_ADDRESS/CONTRACT_NAME/FUNCTION_NAME -H 'Content-Type: application/json' --data '{\"sender\":\"STX_ADDRESS\",\"arguments\":[]}'",
    "call_read_only_with_args": "curl -X POST https://api.mainnet.hiro.so/v2/contracts/call-read/CONTRACT_ADDRESS/CONTRACT_NAME/FUNCTION_NAME -H 'Content-Type: application/json' --data '{\"sender\":\"STX_ADDRESS\",\"arguments\":[\"0x0200000004AABBCCDD\"]}'",
    "get_contract_events": "curl https://api.mainnet.hiro.so/extended/v1/contract/CONTRACT_ADDRESS.CONTRACT_NAME/events",
    "get_contract_by_trait": "curl 'https://api.mainnet.hiro.so/extended/v1/contract/by_trait?trait_abi=TRAIT_ABI'",
    "get_fee_estimate": "curl https://api.mainnet.hiro.so/v2/fees/transfer",
    "get_fee_estimate_transaction": "curl -X POST https://api.mainnet.hiro.so/v2/fees/transaction -H 'Content-Type: application/json' --data '{\"transaction_payload\":\"TX_PAYLOAD_HEX\",\"estimated_len\":300}'",
    "get_stx_supply": "curl https://api.mainnet.hiro.so/extended/v1/stx_supply",
    "get_stx_supply_total": "curl https://api.mainnet.hiro.so/extended/v1/stx_supply/total/plain",
    "get_stx_supply_circulating": "curl https://api.mainnet.hiro.so/extended/v1/stx_supply/circulating/plain",
    "search_query": "curl https://api.mainnet.hiro.so/extended/v1/search/QUERY",
    "get_burn_block": "curl https://api.mainnet.hiro.so/extended/v2/burn-blocks/BURN_BLOCK_HEIGHT",
    "get_burn_blocks": "curl https://api.mainnet.hiro.so/extended/v2/burn-blocks",
    "get_stacking_pool": "curl https://api.mainnet.hiro.so/extended/v1/pox4/POOL_PRINCIPAL/delegations",
    "ws_subscribe_blocks": "wscat -c wss://api.mainnet.hiro.so -x '{\"type\":\"subscribe\",\"name\":\"block\"}'",
    "ws_subscribe_tx": "wscat -c wss://api.mainnet.hiro.so -x '{\"type\":\"subscribe\",\"name\":\"transaction\",\"tx_id\":\"TX_ID\"}'",
    "ws_subscribe_address": "wscat -c wss://api.mainnet.hiro.so -x '{\"type\":\"subscribe\",\"name\":\"address_transaction\",\"address\":\"STX_ADDRESS\"}'",
    "ws_subscribe_mempool": "wscat -c wss://api.mainnet.hiro.so -x '{\"type\":\"subscribe\",\"name\":\"mempool\"}'"
  }
}
