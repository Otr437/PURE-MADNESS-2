{
  "chain": "Stacks",
  "symbol": "STX",
  "type": "Bitcoin L2",
  "block_explorer": "https://explorer.hiro.so",
  "public_rpc": "https://api.mainnet.hiro.so",
  "install_commands": {
    "npm_cli_global": "npm install -g @stacks/cli",
    "npm_transactions": "npm install @stacks/transactions",
    "npm_network": "npm install @stacks/network",
    "npm_wallet_sdk": "npm install @stacks/wallet-sdk",
    "npm_connect": "npm install @stacks/connect",
    "npm_stacking": "npm install @stacks/stacking",
    "npm_bns": "npm install @stacks/bns",
    "npm_all": "npm install @stacks/transactions @stacks/network @stacks/wallet-sdk @stacks/connect",
    "docker_run_node": "docker run -d --rm --name stacks-blockchain -v $(pwd)/persistent-data/stacks-blockchain/mainnet:/root/stacks-node/data -v $(pwd)/config/mainnet:/src/stacks-node -p 20443:20443 -p 20444:20444 blockstack/stacks-blockchain /bin/stacks-node start --config /src/stacks-node/Config.toml",
    "docker_check_running": "docker ps | grep stacks-blockchain",
    "docker_check_logs": "docker logs stacks-blockchain",
    "pip_stacks": "pip install stacks-api"
  },
  "stx_cli_commands": {
    "help": "stx help",
    "help_all": "stx help all",
    "get_address_balance": "stx balance ADDRESS -t https://api.mainnet.hiro.so",
    "get_account_info": "stx accounts ADDRESS",
    "make_keychain": "stx make_keychain",
    "get_owner_keys": "stx get_owner_keys MNEMONIC_PHRASE",
    "get_app_keys": "stx get_app_keys MNEMONIC GAIA_HUB APP_URL",
    "send_tokens": "stx send_tokens RECIPIENT AMOUNT FEE NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "deploy_contract": "stx deploy_contract CONTRACT_NAME /path/to/contract.clar FEE NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "call_contract": "stx call_contract_func CONTRACT_ADDRESS CONTRACT_NAME FUNCTION_NAME FEE NONCE PRIVATE_KEY -t https://api.mainnet.hiro.so",
    "gaia_dump": "stx gaia_dump_bucket USERNAME GAIA_HUB APP_URL ./backups MNEMONIC",
    "profile_sign": "stx profile_sign /path/to/profile.json PRIVATE_KEY",
    "version": "stx --version"
  },
  "curl_commands": {
    "get_node_info": "curl https://api.mainnet.hiro.so/v2/info",
    "get_account_info": "curl https://api.mainnet.hiro.so/v2/accounts/YOUR_STX_ADDRESS",
    "get_account_balances": "curl https://api.mainnet.hiro.so/extended/v1/address/YOUR_STX_ADDRESS/balances",
    "get_account_transactions": "curl https://api.mainnet.hiro.so/extended/v1/address/YOUR_STX_ADDRESS/transactions",
    "get_transaction": "curl https://api.mainnet.hiro.so/extended/v1/tx/TX_HASH",
    "get_raw_transaction": "curl https://api.mainnet.hiro.so/extended/v1/tx/TX_HASH/raw",
    "get_latest_blocks": "curl https://api.mainnet.hiro.so/extended/v1/block",
    "get_block_by_height": "curl https://api.mainnet.hiro.so/extended/v1/block/by_height/BLOCK_HEIGHT",
    "get_contract_info": "curl https://api.mainnet.hiro.so/extended/v1/contract/CONTRACT_ADDRESS.CONTRACT_NAME",
    "get_contract_interface": "curl https://api.mainnet.hiro.so/v2/contracts/interface/CONTRACT_ADDRESS/CONTRACT_NAME",
    "get_contract_source": "curl https://api.mainnet.hiro.so/v2/contracts/source/CONTRACT_ADDRESS/CONTRACT_NAME",
    "call_read_only": "curl -X POST https://api.mainnet.hiro.so/v2/contracts/call-read/CONTRACT_ADDRESS/CONTRACT_NAME/FUNCTION_NAME -H 'Content-Type: application/json' --data '{\"sender\":\"YOUR_ADDRESS\",\"arguments\":[]}'",
    "broadcast_transaction": "curl -X POST https://api.mainnet.hiro.so/v2/transactions -H 'Content-Type: application/octet-stream' --data-binary @signed_tx.bin",
    "get_fee_estimate": "curl https://api.mainnet.hiro.so/v2/fees/transfer",
    "get_mempool": "curl https://api.mainnet.hiro.so/extended/v1/tx/mempool",
    "get_nonces": "curl https://api.mainnet.hiro.so/extended/v1/address/YOUR_STX_ADDRESS/nonces",
    "get_stx_supply": "curl https://api.mainnet.hiro.so/extended/v1/stx_supply",
    "get_pox_info": "curl https://api.mainnet.hiro.so/v2/pox",
    "search": "curl https://api.mainnet.hiro.so/extended/v1/search/QUERY",
    "testnet_node_info": "curl https://api.testnet.hiro.so/v2/info",
    "testnet_balance": "curl https://api.testnet.hiro.so/extended/v1/address/YOUR_ADDRESS/balances"
  },
  "testnet": {
    "api_url": "https://api.testnet.hiro.so",
    "explorer": "https://explorer.hiro.so/?chain=testnet",
    "faucet": "https://explorer.hiro.so/sandbox/faucet?chain=testnet"
  }
}
