{
  "chain": "XRPL EVM Sidechain",
  "install": {
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash",
    "foundry_update": "foundryup",
    "forge_init": "forge init my-xrpl-project",
    "forge_install_oz": "forge install OpenZeppelin/openzeppelin-contracts --no-commit",
    "hardhat_setup": "npm init -y && npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv",
    "hardhat_init": "npx hardhat init",
    "npm_ethers": "npm install ethers",
    "npm_viem": "npm install viem",
    "npm_web3": "npm install web3",
    "pip_web3": "pip install web3 eth-account python-dotenv",
    "wscat": "npm install -g wscat"
  },
  "hardhat": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "test_fork": "npx hardhat test --network hardhat",
    "deploy_mainnet": "npx hardhat run scripts/deploy.ts --network xrplEVM",
    "deploy_testnet": "npx hardhat run scripts/deploy.ts --network xrplEVMTestnet",
    "verify": "npx hardhat verify --network xrplEVM CONTRACT_ADDRESS",
    "ignition_mainnet": "npx hardhat ignition deploy ignition/modules/Deploy.ts --network xrplEVM",
    "ignition_testnet": "npx hardhat ignition deploy ignition/modules/Deploy.ts --network xrplEVMTestnet",
    "clean": "npx hardhat clean",
    "node": "npx hardhat node"
  },
  "forge": {
    "build": "forge build",
    "test": "forge test -vvv",
    "test_fork_mainnet": "forge test --fork-url https://rpc.xrplevm.org -vvv",
    "test_fork_testnet": "forge test --fork-url https://rpc.testnet.xrplevm.org -vvv",
    "deploy_mainnet": "forge create src/Contract.sol:Contract --rpc-url https://rpc.xrplevm.org --private-key $PRIVATE_KEY --broadcast",
    "deploy_testnet": "forge create src/Contract.sol:Contract --rpc-url https://rpc.testnet.xrplevm.org --private-key $PRIVATE_KEY --broadcast --legacy",
    "script_mainnet": "forge script script/Deploy.s.sol --rpc-url https://rpc.xrplevm.org --broadcast --account MyAccount",
    "script_testnet": "forge script script/Deploy.s.sol --rpc-url https://rpc.testnet.xrplevm.org --broadcast --account MyAccount --legacy",
    "script_verbose": "forge script script/Deploy.s.sol --rpc-url https://rpc.xrplevm.org --broadcast -vvvv",
    "verify": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 1440000",
    "snapshot": "forge snapshot",
    "coverage": "forge coverage",
    "flatten": "forge flatten src/Contract.sol",
    "inspect_abi": "forge inspect src/Contract.sol:Contract abi",
    "check_broadcast": "cat broadcast/Deploy.s.sol/1440000/run-latest.json"
  },
  "cast": {
    "wallet_import": "cast wallet import MyAccount --interactive",
    "wallet_new": "cast wallet new",
    "block_number": "cast block-number --rpc-url https://rpc.xrplevm.org",
    "block": "cast block latest --rpc-url https://rpc.xrplevm.org",
    "chain_id": "cast chain-id --rpc-url https://rpc.xrplevm.org",
    "gas_price": "cast gas-price --rpc-url https://rpc.xrplevm.org",
    "base_fee": "cast base-fee latest --rpc-url https://rpc.xrplevm.org",
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url https://rpc.xrplevm.org",
    "get_balance_ether": "cast balance YOUR_ADDRESS --ether --rpc-url https://rpc.xrplevm.org",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url https://rpc.xrplevm.org",
    "get_code": "cast code CONTRACT_ADDRESS --rpc-url https://rpc.xrplevm.org",
    "get_storage": "cast storage CONTRACT_ADDRESS SLOT --rpc-url https://rpc.xrplevm.org",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url https://rpc.xrplevm.org",
    "call_balanceof": "cast call CONTRACT 'balanceOf(address)(uint256)' YOUR_ADDRESS --rpc-url https://rpc.xrplevm.org",
    "send_tx": "cast send TO_ADDRESS --value 0.01ether --rpc-url https://rpc.xrplevm.org --account MyAccount",
    "send_contract": "cast send CONTRACT 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://rpc.xrplevm.org --account MyAccount",
    "get_tx": "cast tx TX_HASH --rpc-url https://rpc.xrplevm.org",
    "get_receipt": "cast receipt TX_HASH --rpc-url https://rpc.xrplevm.org",
    "estimate_gas": "cast estimate TO_ADDRESS 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://rpc.xrplevm.org",
    "decode_calldata": "cast 4byte-decode 0xCALLDATA_HEX",
    "keccak": "cast keccak 'transfer(address,uint256)'",
    "to_wei": "cast to-wei 1 ether",
    "from_wei": "cast from-wei 1000000000000000000",
    "testnet_balance": "cast balance YOUR_ADDRESS --rpc-url https://rpc.testnet.xrplevm.org",
    "testnet_block": "cast block-number --rpc-url https://rpc.testnet.xrplevm.org"
  },
  "anvil": {
    "fork_mainnet": "anvil --fork-url https://rpc.xrplevm.org",
    "fork_testnet": "anvil --fork-url https://rpc.testnet.xrplevm.org",
    "set_balance": "cast rpc anvil_setBalance 0xYOUR_ADDRESS 0xDE0B6B3A7640000 --rpc-url http://127.0.0.1:8545",
    "impersonate": "cast rpc anvil_impersonateAccount 0xADDRESS --rpc-url http://127.0.0.1:8545",
    "mine": "cast rpc anvil_mine 1 --rpc-url http://127.0.0.1:8545"
  },
  "curl": {
    "web3_clientVersion": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "net_listening": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_listening\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_blockNumber": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getCode": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_sendRawTransaction": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX_HEX\"],\"id\":1}'",
    "eth_call": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_getBlockByNumber_latest": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByNumber_pending": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"pending\",false],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newFilter": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_feeHistory": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_createAccessList": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_createAccessList\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC\"},\"latest\"],\"id\":1}'",
    "eth_subscribe_newHeads": "wscat -c wss://wss.xrplevm.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "eth_subscribe_logs": "wscat -c wss://wss.xrplevm.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"logs\",{\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_subscribe_pendingTx": "wscat -c wss://wss.xrplevm.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newPendingTransactions\"],\"id\":1}'",
    "testnet_block_number": "curl -X POST https://rpc.testnet.xrplevm.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "testnet_subscribe": "wscat -c wss://wss.testnet.xrplevm.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "batch_request": "curl -X POST https://rpc.xrplevm.org -H 'Content-Type: application/json' --data '[{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":3}]'"
  }
}
