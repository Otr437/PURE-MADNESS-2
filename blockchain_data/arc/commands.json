{
  "chain": "Arc",
  "install": {
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash && foundryup",
    "forge_init": "forge init my-arc-project",
    "forge_install_oz": "forge install OpenZeppelin/openzeppelin-contracts --no-commit",
    "hardhat_setup": "npm init -y && npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv",
    "hardhat_init": "npx hardhat init",
    "npm_ethers": "npm install ethers",
    "npm_viem": "npm install viem",
    "npm_web3": "npm install web3",
    "npm_circle_cctp": "npm install @circle-fin/cross-chain-transfer-protocol",
    "pip_web3": "pip install web3 eth-account python-dotenv",
    "wscat": "npm install -g wscat"
  },
  "hardhat": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy_testnet": "npx hardhat run scripts/deploy.js --network arcTestnet",
    "verify_testnet": "npx hardhat verify --network arcTestnet CONTRACT_ADDRESS",
    "clean": "npx hardhat clean",
    "node": "npx hardhat node"
  },
  "forge": {
    "build": "forge build",
    "test": "forge test -vvv",
    "deploy_testnet": "forge create src/Contract.sol:Contract --rpc-url $ARC_TESTNET_RPC --private-key $PRIVATE_KEY --broadcast",
    "script_testnet": "forge script script/Deploy.s.sol --rpc-url $ARC_TESTNET_RPC --broadcast --account MyAccount",
    "verify_testnet": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 5042002",
    "install_oz": "forge install OpenZeppelin/openzeppelin-contracts --no-commit",
    "snapshot": "forge snapshot",
    "coverage": "forge coverage",
    "flatten": "forge flatten src/Contract.sol",
    "inspect_abi": "forge inspect src/Contract.sol:Contract abi"
  },
  "cast": {
    "wallet_import": "cast wallet import MyAccount --interactive",
    "wallet_new": "cast wallet new",
    "block_number": "cast block-number --rpc-url $ARC_TESTNET_RPC",
    "chain_id": "cast chain-id --rpc-url $ARC_TESTNET_RPC",
    "gas_price": "cast gas-price --rpc-url $ARC_TESTNET_RPC",
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url $ARC_TESTNET_RPC",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url $ARC_TESTNET_RPC",
    "get_code": "cast code CONTRACT_ADDRESS --rpc-url $ARC_TESTNET_RPC",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url $ARC_TESTNET_RPC",
    "send_tx": "cast send TO_ADDRESS --value 0 --rpc-url $ARC_TESTNET_RPC --account MyAccount",
    "get_tx": "cast tx TX_HASH --rpc-url $ARC_TESTNET_RPC",
    "get_receipt": "cast receipt TX_HASH --rpc-url $ARC_TESTNET_RPC",
    "estimate_gas": "cast estimate TO_ADDRESS 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url $ARC_TESTNET_RPC",
    "keccak": "cast keccak 'transfer(address,uint256)'",
    "to_wei": "cast to-wei 1 ether",
    "from_wei": "cast from-wei 1000000000000000000"
  },
  "anvil": {
    "fork_testnet": "anvil --fork-url $ARC_TESTNET_RPC",
    "set_balance": "cast rpc anvil_setBalance 0xYOUR_ADDRESS 0xDE0B6B3A7640000 --rpc-url http://127.0.0.1:8545",
    "impersonate": "cast rpc anvil_impersonateAccount 0xADDRESS --rpc-url http://127.0.0.1:8545",
    "mine": "cast rpc anvil_mine 1 --rpc-url http://127.0.0.1:8545"
  },
  "curl": {
    "web3_clientVersion": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_blockNumber": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getCode": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_sendRawTransaction": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX_HEX\"],\"id\":1}'",
    "eth_call": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_getBlockByNumber": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newFilter": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_feeHistory": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_subscribe_newHeads": "wscat -c $ARC_TESTNET_WSS -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "eth_subscribe_logs": "wscat -c $ARC_TESTNET_WSS -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"logs\",{\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "batch_request": "curl -X POST $ARC_TESTNET_RPC -H 'Content-Type: application/json' --data '[{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":3}]'",
    "note": "Replace $ARC_TESTNET_RPC with your QuickNode or dRPC endpoint URL. Arc uses USDC as gas so no ETH needed."
  }
}
