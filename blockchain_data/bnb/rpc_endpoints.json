{
  "chain": "BNB Smart Chain",
  "symbol": "BNB",
  "chain_id": 56,
  "chain_id_hex": "0x38",
  "consensus": "Proof of Staked Authority",
  "block_time_seconds": 3,
  "block_explorer": "https://bscscan.com",
  "public_rpc_endpoints": [
    { "name": "BNB Official 1", "url": "https://bsc-dataseed.binance.org" },
    { "name": "BNB Official 2", "url": "https://bsc-dataseed1.binance.org" },
    { "name": "BNB Official 3", "url": "https://bsc-dataseed2.binance.org" },
    { "name": "BNB Official 4", "url": "https://bsc-dataseed3.binance.org" },
    { "name": "BNB Official 5", "url": "https://bsc-dataseed4.binance.org" },
    { "name": "PublicNode", "url": "https://bsc-rpc.publicnode.com" },
    { "name": "PublicNode WSS", "url": "wss://bsc-rpc.publicnode.com" },
    { "name": "Ankr", "url": "https://rpc.ankr.com/bsc" },
    { "name": "DRPC", "url": "https://bnb.drpc.org" },
    { "name": "1RPC", "url": "https://1rpc.io/bnb" },
    { "name": "bloXroute MEV protect", "url": "https://bsc.rpc.blxrbdn.com" }
  ],
  "install_commands": {
    "npm_ethers": "npm install ethers",
    "npm_web3": "npm install web3",
    "npm_viem": "npm install viem",
    "hardhat_setup": "npm init -y && npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv && npx hardhat init",
    "hardhat_compile": "npx hardhat compile",
    "hardhat_deploy_mainnet": "npx hardhat run scripts/deploy.js --network bscMainnet",
    "hardhat_deploy_testnet": "npx hardhat run scripts/deploy.js --network bscTestnet",
    "hardhat_verify": "npx hardhat verify --network bscMainnet CONTRACT_ADDRESS",
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash && foundryup",
    "forge_init": "forge init my-bsc-project && cd my-bsc-project",
    "forge_build": "forge build",
    "forge_test": "forge test -vvv",
    "forge_deploy_mainnet": "forge script script/Deploy.s.sol --rpc-url https://bsc-dataseed.binance.org --broadcast --account MyAccount",
    "forge_deploy_testnet": "forge script script/Deploy.s.sol --rpc-url https://data-seed-prebsc-1-s1.binance.org:8545 --broadcast --account MyAccount",
    "forge_verify": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 56 --etherscan-api-key YOUR_BSCSCAN_KEY",
    "anvil_fork": "anvil --fork-url https://bsc-dataseed.binance.org",
    "pip_web3": "pip install web3 eth-account python-dotenv"
  },
  "cast_commands": {
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url https://bsc-dataseed.binance.org",
    "get_block": "cast block latest --rpc-url https://bsc-dataseed.binance.org",
    "get_block_number": "cast block-number --rpc-url https://bsc-dataseed.binance.org",
    "get_chain_id": "cast chain-id --rpc-url https://bsc-dataseed.binance.org",
    "get_gas_price": "cast gas-price --rpc-url https://bsc-dataseed.binance.org",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url https://bsc-dataseed.binance.org",
    "get_code": "cast code CONTRACT_ADDRESS --rpc-url https://bsc-dataseed.binance.org",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url https://bsc-dataseed.binance.org",
    "send_tx": "cast send TO_ADDRESS --value 0.01ether --rpc-url https://bsc-dataseed.binance.org --account MyAccount",
    "get_tx": "cast tx TX_HASH --rpc-url https://bsc-dataseed.binance.org",
    "get_receipt": "cast receipt TX_HASH --rpc-url https://bsc-dataseed.binance.org",
    "estimate_gas": "cast estimate TO_ADDRESS 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://bsc-dataseed.binance.org",
    "get_basefee": "cast base-fee latest --rpc-url https://bsc-dataseed.binance.org",
    "decode_calldata": "cast 4byte-decode 0xCALLDATA_HEX"
  },
  "curl_commands": {
    "web3_clientVersion": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "net_listening": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_listening\",\"params\":[],\"id\":1}'",
    "net_peerCount": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_peerCount\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://bsc-dataseed.binance.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
