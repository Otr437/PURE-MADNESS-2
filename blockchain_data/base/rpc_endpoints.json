{
  "chain": "Base",
  "symbol": "ETH",
  "chain_id": 8453,
  "chain_id_hex": "0x2105",
  "type": "Optimistic Rollup L2 - OP Stack",
  "developer": "Coinbase",
  "block_time_seconds": 2,
  "block_explorer": "https://basescan.org",
  "public_rpc_endpoints": [
    { "name": "Base Official", "url": "https://mainnet.base.org" },
    { "name": "Base Official WSS", "url": "wss://mainnet.base.org" },
    { "name": "PublicNode", "url": "https://base-rpc.publicnode.com" },
    { "name": "DRPC", "url": "https://base.drpc.org" },
    { "name": "Ankr", "url": "https://rpc.ankr.com/base" },
    { "name": "LlamaNodes", "url": "https://base.llamarpc.com" },
    { "name": "1RPC", "url": "https://1rpc.io/base" },
    { "name": "Meowrpc", "url": "https://base.meowrpc.com" }
  ],
  "premium_providers": [
    "Alchemy - https://www.alchemy.com/chain-connect/base",
    "QuickNode - https://www.quicknode.com/chains/base",
    "Chainstack - https://chainstack.com",
    "Infura - https://infura.io",
    "dRPC - https://drpc.org"
  ],
  "install_commands": {
    "npm_ethers": "npm install ethers",
    "npm_viem": "npm install viem",
    "npm_web3": "npm install web3",
    "npm_onchainkit": "npm install @coinbase/onchainkit",
    "npm_wagmi": "npm install wagmi viem @tanstack/react-query",
    "hardhat_setup": "npm install --save-dev hardhat @nomicfoundation/hardhat-toolbox dotenv && npx hardhat init",
    "foundry_install": "curl -L https://foundry.paradigm.xyz | bash && foundryup",
    "forge_init": "forge init my-base-project && cd my-base-project",
    "forge_build": "forge build",
    "forge_test": "forge test -vvv",
    "forge_deploy_mainnet": "forge script script/Deploy.s.sol --rpc-url https://mainnet.base.org --broadcast --account MyAccount",
    "forge_deploy_sepolia": "forge script script/Deploy.s.sol --rpc-url https://sepolia.base.org --broadcast --account MyAccount",
    "forge_verify": "forge verify-contract CONTRACT_ADDRESS src/Contract.sol:Contract --chain 8453 --etherscan-api-key YOUR_BASESCAN_KEY",
    "anvil_fork": "anvil --fork-url https://mainnet.base.org",
    "cast_wallet_import": "cast wallet import MyAccount --interactive",
    "pip_web3": "pip install web3 eth-account python-dotenv"
  },
  "cast_commands": {
    "get_balance": "cast balance YOUR_ADDRESS --rpc-url https://mainnet.base.org",
    "get_block": "cast block latest --rpc-url https://mainnet.base.org",
    "get_block_number": "cast block-number --rpc-url https://mainnet.base.org",
    "get_chain_id": "cast chain-id --rpc-url https://mainnet.base.org",
    "get_gas_price": "cast gas-price --rpc-url https://mainnet.base.org",
    "get_nonce": "cast nonce YOUR_ADDRESS --rpc-url https://mainnet.base.org",
    "get_code": "cast code CONTRACT_ADDRESS --rpc-url https://mainnet.base.org",
    "get_storage": "cast storage CONTRACT_ADDRESS SLOT --rpc-url https://mainnet.base.org",
    "call_contract": "cast call CONTRACT 'functionName()(returnType)' --rpc-url https://mainnet.base.org",
    "send_tx": "cast send TO_ADDRESS --value 0.001ether --rpc-url https://mainnet.base.org --account MyAccount",
    "decode_tx": "cast tx TX_HASH --rpc-url https://mainnet.base.org",
    "get_receipt": "cast receipt TX_HASH --rpc-url https://mainnet.base.org",
    "estimate_gas": "cast estimate TO_ADDRESS 'transfer(address,uint256)' RECIPIENT AMOUNT --rpc-url https://mainnet.base.org",
    "get_logs": "cast logs --address CONTRACT_ADDRESS --rpc-url https://mainnet.base.org",
    "decode_calldata": "cast 4byte-decode 0xCALLDATA_HEX",
    "get_abi": "cast abi CONTRACT_ADDRESS --rpc-url https://mainnet.base.org",
    "compute_address": "cast compute-address YOUR_ADDRESS --nonce NONCE",
    "get_basefee": "cast base-fee latest --rpc-url https://mainnet.base.org",
    "convert_to_wei": "cast to-wei 1 ether",
    "convert_from_wei": "cast from-wei 1000000000000000000"
  },
  "curl_commands": {
    "web3_clientVersion": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "net_version": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "net_listening": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_listening\",\"params\":[],\"id\":1}'",
    "net_peerCount": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_peerCount\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_syncing": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_blockNumber": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_getBlockTransactionCountByHash": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockTransactionCountByHash\",\"params\":[\"0xBLOCK_HASH\"],\"id\":1}'",
    "eth_getBlockTransactionCountByNumber": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockTransactionCountByNumber\",\"params\":[\"latest\"],\"id\":1}'",
    "eth_getCode": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_sendRawTransaction": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX_HEX\"],\"id\":1}'",
    "eth_call": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_getBlockByNumber_latest": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByNumber_pending": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"pending\",false],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionByBlockHashAndIndex": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByBlockHashAndIndex\",\"params\":[\"0xBLOCK_HASH\",\"0x0\"],\"id\":1}'",
    "eth_getTransactionByBlockNumberAndIndex": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByBlockNumberAndIndex\",\"params\":[\"latest\",\"0x0\"],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_newFilter": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_newPendingTransactionFilter": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newPendingTransactionFilter\",\"params\":[],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getFilterLogs": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterLogs\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"0x0\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_feeHistory": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_createAccessList": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_createAccessList\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC\"},\"latest\"],\"id\":1}'",
    "eth_subscribe_newHeads": "wscat -c wss://mainnet.base.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newHeads\"],\"id\":1}'",
    "eth_subscribe_logs": "wscat -c wss://mainnet.base.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"logs\",{\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_subscribe_newPendingTx": "wscat -c wss://mainnet.base.org -x '{\"jsonrpc\":\"2.0\",\"method\":\"eth_subscribe\",\"params\":[\"newPendingTransactions\"],\"id\":1}'",
    "debug_traceTransaction": "curl -X POST https://base.drpc.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"debug_traceTransaction\",\"params\":[\"0xTX_HASH\",{}],\"id\":1}'",
    "debug_traceBlockByNumber": "curl -X POST https://base.drpc.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"debug_traceBlockByNumber\",\"params\":[\"latest\",{}],\"id\":1}'",
    "txpool_status": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_status\",\"params\":[],\"id\":1}'",
    "txpool_content": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_content\",\"params\":[],\"id\":1}'",
    "optimism_outputAtBlock": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"optimism_outputAtBlock\",\"params\":[\"latest\"],\"id\":1}'",
    "optimism_syncStatus": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"optimism_syncStatus\",\"params\":[],\"id\":1}'",
    "optimism_rollupConfig": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"optimism_rollupConfig\",\"params\":[],\"id\":1}'",
    "optimism_version": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"optimism_version\",\"params\":[],\"id\":1}'",
    "batch_request": "curl -X POST https://mainnet.base.org -H 'Content-Type: application/json' --data '[{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":3}]'"
  },
