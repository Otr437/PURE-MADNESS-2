{
  "chain": "Bitcoin",
  "install": {
    "snap": "sudo snap install bitcoin-core",
    "apt": "sudo apt update && sudo apt install bitcoind bitcoin-tx bitcoin-util",
    "build_deps": "sudo apt install build-essential libtool autotools-dev automake pkg-config bsdmainutils python3 libssl-dev libevent-dev libboost-system-dev libboost-filesystem-dev libboost-chrono-dev libboost-program-options-dev libboost-test-dev libboost-thread-dev libdb++-dev libzmq3-dev",
    "build_clone": "git clone https://github.com/bitcoin/bitcoin.git && cd bitcoin",
    "build_checkout": "git checkout v28.1",
    "build_autogen": "./autogen.sh",
    "build_configure": "./configure --with-gui=no",
    "build_make": "make -j$(nproc)",
    "build_install": "sudo make install",
    "create_conf": "mkdir -p ~/.bitcoin && touch ~/.bitcoin/bitcoin.conf",
    "pip_bitcoinlib": "pip install python-bitcoinlib",
    "pip_bitcoinrpc": "pip install python-bitcoinrpc",
    "npm_bitcoinjs": "npm install bitcoinjs-lib",
    "npm_bitcore": "npm install bitcore-lib"
  },
  "node": {
    "start": "bitcoind",
    "start_daemon": "bitcoind -daemon",
    "start_testnet4": "bitcoind -testnet4 -daemon",
    "start_signet": "bitcoind -signet -daemon",
    "start_regtest": "bitcoind -regtest -daemon",
    "stop": "bitcoin-cli stop",
    "version": "bitcoin-cli --version",
    "reindex": "bitcoind -reindex",
    "rescan": "bitcoin-cli rescanblockchain"
  },
  "bitcoin_cli": {
    "help": "bitcoin-cli help",
    "help_command": "bitcoin-cli help getblockchaininfo",
    "getblockchaininfo": "bitcoin-cli getblockchaininfo",
    "getblockcount": "bitcoin-cli getblockcount",
    "getblockhash": "bitcoin-cli getblockhash BLOCK_HEIGHT",
    "getblock": "bitcoin-cli getblock BLOCK_HASH",
    "getblock_verbose": "bitcoin-cli getblock BLOCK_HASH 2",
    "getbestblockhash": "bitcoin-cli getbestblockhash",
    "getblockheader": "bitcoin-cli getblockheader BLOCK_HASH",
    "getblockstats": "bitcoin-cli getblockstats BLOCK_HEIGHT",
    "getchaintips": "bitcoin-cli getchaintips",
    "getdifficulty": "bitcoin-cli getdifficulty",
    "gettxout": "bitcoin-cli gettxout TX_HASH VOUT_INDEX",
    "gettxoutsetinfo": "bitcoin-cli gettxoutsetinfo",
    "getrawtransaction": "bitcoin-cli getrawtransaction TX_HASH true",
    "decoderawtransaction": "bitcoin-cli decoderawtransaction RAW_TX_HEX",
    "decodescript": "bitcoin-cli decodescript SCRIPT_HEX",
    "sendrawtransaction": "bitcoin-cli sendrawtransaction SIGNED_TX_HEX",
    "testmempoolaccept": "bitcoin-cli testmempoolaccept '[\"SIGNED_TX_HEX\"]'",
    "getrawmempool": "bitcoin-cli getrawmempool",
    "getrawmempool_verbose": "bitcoin-cli getrawmempool true",
    "getmempoolinfo": "bitcoin-cli getmempoolinfo",
    "getmempoolentry": "bitcoin-cli getmempoolentry TX_HASH",
    "getmempoolancestors": "bitcoin-cli getmempoolancestors TX_HASH",
    "getmempooldescendants": "bitcoin-cli getmempooldescendants TX_HASH",
    "estimatesmartfee": "bitcoin-cli estimatesmartfee 6",
    "estimatesmartfee_conservative": "bitcoin-cli estimatesmartfee 6 CONSERVATIVE",
    "getnewaddress": "bitcoin-cli getnewaddress",
    "getnewaddress_bech32": "bitcoin-cli getnewaddress '' bech32",
    "getnewaddress_bech32m": "bitcoin-cli getnewaddress '' bech32m",
    "getnewaddress_p2sh": "bitcoin-cli getnewaddress '' p2sh-segwit",
    "getaddressesbylabel": "bitcoin-cli getaddressesbylabel ''",
    "getaddressinfo": "bitcoin-cli getaddressinfo BTC_ADDRESS",
    "validateaddress": "bitcoin-cli validateaddress BTC_ADDRESS",
    "getbalance": "bitcoin-cli getbalance",
    "getbalances": "bitcoin-cli getbalances",
    "getunconfirmedbalance": "bitcoin-cli getunconfirmedbalance",
    "getwalletinfo": "bitcoin-cli getwalletinfo",
    "listwallets": "bitcoin-cli listwallets",
    "createwallet": "bitcoin-cli createwallet WALLET_NAME",
    "loadwallet": "bitcoin-cli loadwallet WALLET_NAME",
    "unloadwallet": "bitcoin-cli unloadwallet WALLET_NAME",
    "backupwallet": "bitcoin-cli backupwallet /path/to/backup.dat",
    "dumpwallet": "bitcoin-cli dumpwallet /path/to/wallet.txt",
    "importwallet": "bitcoin-cli importwallet /path/to/wallet.txt",
    "dumpprivkey": "bitcoin-cli dumpprivkey BTC_ADDRESS",
    "importprivkey": "bitcoin-cli importprivkey PRIVATE_KEY '' false",
    "importaddress": "bitcoin-cli importaddress BTC_ADDRESS '' false",
    "importmulti": "bitcoin-cli importmulti '[{\"scriptPubKey\":{\"address\":\"ADDRESS\"},\"timestamp\":\"now\"}]'",
    "importdescriptors": "bitcoin-cli importdescriptors '[{\"desc\":\"DESCRIPTOR\",\"timestamp\":\"now\"}]'",
    "listunspent": "bitcoin-cli listunspent",
    "listunspent_filtered": "bitcoin-cli listunspent 1 9999999 '[\"BTC_ADDRESS\"]'",
    "listtransactions": "bitcoin-cli listtransactions",
    "listsinceblock": "bitcoin-cli listsinceblock BLOCK_HASH",
    "gettransaction": "bitcoin-cli gettransaction TX_HASH",
    "sendtoaddress": "bitcoin-cli sendtoaddress BTC_ADDRESS AMOUNT",
    "sendtoaddress_subtract_fee": "bitcoin-cli sendtoaddress BTC_ADDRESS AMOUNT '' '' true",
    "sendmany": "bitcoin-cli sendmany '' '{\"ADDRESS1\":0.01,\"ADDRESS2\":0.02}'",
    "createrawtransaction": "bitcoin-cli createrawtransaction '[{\"txid\":\"TXID\",\"vout\":0}]' '[{\"ADDRESS\":0.001}]'",
    "createrawtransaction_with_change": "bitcoin-cli createrawtransaction '[{\"txid\":\"TXID\",\"vout\":0}]' '[{\"ADDRESS\":0.001},{\"CHANGE_ADDRESS\":0.0009}]'",
    "fundrawtransaction": "bitcoin-cli fundrawtransaction RAW_TX_HEX",
    "signrawtransactionwithkey": "bitcoin-cli signrawtransactionwithkey RAW_TX_HEX '[\"PRIVATE_KEY\"]'",
    "signrawtransactionwithwallet": "bitcoin-cli signrawtransactionwithwallet RAW_TX_HEX",
    "analyzepsbt": "bitcoin-cli analyzepsbt PSBT_BASE64",
    "createpsbt": "bitcoin-cli createpsbt '[{\"txid\":\"TXID\",\"vout\":0}]' '[{\"ADDRESS\":0.001}]'",
    "decodepsbt": "bitcoin-cli decodepsbt PSBT_BASE64",
    "finalizepsbt": "bitcoin-cli finalizepsbt PSBT_BASE64",
    "combinepsbt": "bitcoin-cli combinepsbt '[\"PSBT1\",\"PSBT2\"]'",
    "joinpsbts": "bitcoin-cli joinpsbts '[\"PSBT1\",\"PSBT2\"]'",
    "walletprocesspsbt": "bitcoin-cli walletprocesspsbt PSBT_BASE64",
    "walletcreatefundedpsbt": "bitcoin-cli walletcreatefundedpsbt '[{\"txid\":\"TXID\",\"vout\":0}]' '[{\"ADDRESS\":0.001}]'",
    "lockunspent": "bitcoin-cli lockunspent false '[{\"txid\":\"TXID\",\"vout\":0}]'",
    "lockunspent_unlock": "bitcoin-cli lockunspent true '[{\"txid\":\"TXID\",\"vout\":0}]'",
    "listlockunspent": "bitcoin-cli listlockunspent",
    "getnetworkinfo": "bitcoin-cli getnetworkinfo",
    "getpeerinfo": "bitcoin-cli getpeerinfo",
    "getconnectioncount": "bitcoin-cli getconnectioncount",
    "addnode": "bitcoin-cli addnode IP:PORT add",
    "disconnectnode": "bitcoin-cli disconnectnode IP:PORT",
    "listbanned": "bitcoin-cli listbanned",
    "setban": "bitcoin-cli setban IP:PORT add 86400",
    "clearbanned": "bitcoin-cli clearbanned",
    "getmininginfo": "bitcoin-cli getmininginfo",
    "getnetworkhashps": "bitcoin-cli getnetworkhashps",
    "generate_regtest": "bitcoin-cli -regtest generatetoaddress 101 $(bitcoin-cli -regtest getnewaddress)",
    "generate_regtest_blocks": "bitcoin-cli -regtest generatetoaddress 10 BTC_ADDRESS",
    "invalidateblock": "bitcoin-cli invalidateblock BLOCK_HASH",
    "reconsiderblock": "bitcoin-cli reconsiderblock BLOCK_HASH",
    "getindexinfo": "bitcoin-cli getindexinfo",
    "getchaintxstats": "bitcoin-cli getchaintxstats",
    "getdeploymentinfo": "bitcoin-cli getdeploymentinfo",
    "scantxoutset": "bitcoin-cli scantxoutset start '[\"addr(BTC_ADDRESS)\"]'"
  },
  "curl": {
    "getblockchaininfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockchaininfo\",\"params\":[]}'",
    "getblockcount": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockcount\",\"params\":[]}'",
    "getblockhash": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockhash\",\"params\":[BLOCK_HEIGHT]}'",
    "getblock": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblock\",\"params\":[\"BLOCK_HASH\"]}'",
    "getblock_verbose": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblock\",\"params\":[\"BLOCK_HASH\",2]}'",
    "getrawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getrawtransaction\",\"params\":[\"TX_HASH\",true]}'",
    "sendrawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"sendrawtransaction\",\"params\":[\"SIGNED_TX_HEX\"]}'",
    "testmempoolaccept": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"testmempoolaccept\",\"params\":[[\"SIGNED_TX_HEX\"]]}'",
    "getrawmempool": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getrawmempool\",\"params\":[]}'",
    "getmempoolinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getmempoolinfo\",\"params\":[]}'",
    "getmempoolentry": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getmempoolentry\",\"params\":[\"TX_HASH\"]}'",
    "estimatesmartfee": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"estimatesmartfee\",\"params\":[6]}'",
    "getbalance": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getbalance\",\"params\":[]}'",
    "getnewaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getnewaddress\",\"params\":[]}'",
    "validateaddress": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"validateaddress\",\"params\":[\"BTC_ADDRESS\"]}'",
    "getnetworkinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getnetworkinfo\",\"params\":[]}'",
    "getwalletinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getwalletinfo\",\"params\":[]}'",
    "listunspent": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"listunspent\",\"params\":[]}'",
    "createrawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"createrawtransaction\",\"params\":[[{\"txid\":\"TXID\",\"vout\":0}],[{\"ADDRESS\":0.001}]]}'",
    "decoderawtransaction": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"decoderawtransaction\",\"params\":[\"RAW_TX_HEX\"]}'",
    "getchaintips": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getchaintips\",\"params\":[]}'",
    "gettxoutsetinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"gettxoutsetinfo\",\"params\":[]}'",
    "getmininginfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getmininginfo\",\"params\":[]}'",
    "getpeerinfo": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getpeerinfo\",\"params\":[]}'",
    "getblockstats": "curl --user rpcuser:rpcpassword -H 'content-type: text/plain;' http://127.0.0.1:8332/ --data '{\"jsonrpc\":\"1.0\",\"id\":\"test\",\"method\":\"getblockstats\",\"params\":[BLOCK_HEIGHT]}'"
  },
  "mempool_space_api": {
    "get_fees": "curl https://mempool.space/api/v1/fees/recommended",
    "get_tx": "curl https://mempool.space/api/tx/TX_HASH",
    "get_tx_hex": "curl https://mempool.space/api/tx/TX_HASH/hex",
    "get_tx_merkle": "curl https://mempool.space/api/tx/TX_HASH/merkle-proof",
    "get_tx_status": "curl https://mempool.space/api/tx/TX_HASH/status",
    "get_block_height": "curl https://mempool.space/api/block-height/BLOCK_NUMBER",
    "get_block": "curl https://mempool.space/api/block/BLOCK_HASH",
    "get_block_txids": "curl https://mempool.space/api/block/BLOCK_HASH/txids",
    "get_block_txs": "curl https://mempool.space/api/block/BLOCK_HASH/txs",
    "get_blocks_recent": "curl https://mempool.space/api/v1/blocks",
    "get_address": "curl https://mempool.space/api/address/BTC_ADDRESS",
    "get_address_txs": "curl https://mempool.space/api/address/BTC_ADDRESS/txs",
    "get_address_txs_mempool": "curl https://mempool.space/api/address/BTC_ADDRESS/txs/mempool",
    "get_address_utxo": "curl https://mempool.space/api/address/BTC_ADDRESS/utxo",
    "broadcast_tx": "curl -X POST https://mempool.space/api/tx --data 'SIGNED_TX_HEX'",
    "get_mempool": "curl https://mempool.space/api/mempool",
    "get_mempool_txids": "curl https://mempool.space/api/mempool/txids",
    "get_difficulty_adjustment": "curl https://mempool.space/api/v1/difficulty-adjustment",
    "get_historical_price": "curl https://mempool.space/api/v1/historical-price",
    "testnet4_get_fees": "curl https://mempool.space/testnet4/api/v1/fees/recommended",
    "testnet4_broadcast_tx": "curl -X POST https://mempool.space/testnet4/api/tx --data 'SIGNED_TX_HEX'",
    "signet_get_fees": "curl https://mempool.space/signet/api/v1/fees/recommended",
    "ws_subscribe_blocks": "wscat -c wss://mempool.space/api/v1/ws -x '{\"action\":\"want\",\"data\":[\"blocks\"]}'",
    "ws_subscribe_address": "wscat -c wss://mempool.space/api/v1/ws -x '{\"track-address\":\"BTC_ADDRESS\"}'",
    "ws_subscribe_mempool": "wscat -c wss://mempool.space/api/v1/ws -x '{\"action\":\"want\",\"data\":[\"mempool-blocks\"]}'"
  }
}
