{
  "chain": "Flashbots",
  "install": {
    "npm_ethers": "npm install ethers",
    "npm_bundle": "npm install @flashbots/ethers-provider-bundle",
    "npm_mev_share": "npm install @flashbots/mev-share-client",
    "pip_flashbots": "pip install flashbots",
    "pip_web3": "pip install web3 eth-account python-dotenv",
    "mev_boost_download": "wget https://github.com/flashbots/mev-boost/releases/latest/download/mev-boost_linux_amd64.tar.gz",
    "mev_boost_extract": "tar xvf mev-boost_linux_amd64.tar.gz",
    "mev_boost_docker": "docker pull flashbots/mev-boost:latest",
    "rbuilder_clone": "git clone https://github.com/flashbots/rbuilder.git",
    "rbuilder_build": "cd rbuilder && cargo build --release",
    "rbuilder_run": "./target/release/rbuilder run config.toml"
  },
  "mev_boost": {
    "run_mainnet_single_relay": "./mev-boost -mainnet -relay-check -relays https://boost-relay.flashbots.net",
    "run_mainnet_all_relays": "./mev-boost -mainnet -relay-check -relays https://boost-relay.flashbots.net,https://relay.ultrasound.money,https://titanrelay.xyz,https://bloxroute.max-profit.blxrbdn.com,https://bloxroute.regulated.blxrbdn.com,https://aestus.live,https://agnostic-relay.net",
    "run_docker_mainnet": "docker run flashbots/mev-boost -mainnet -relay-check -relays https://boost-relay.flashbots.net",
    "run_sepolia": "./mev-boost -sepolia -relay-check -relays https://boost-relay-sepolia.flashbots.net",
    "check_relay_flashbots": "curl https://boost-relay.flashbots.net/relay/v1/builder/validators",
    "check_relay_ultrasound": "curl https://relay.ultrasound.money/relay/v1/builder/validators",
    "check_relay_titan": "curl https://titanrelay.xyz/relay/v1/builder/validators",
    "check_relay_bloxroute": "curl https://bloxroute.max-profit.blxrbdn.com/relay/v1/builder/validators",
    "check_relay_aestus": "curl https://aestus.live/relay/v1/builder/validators"
  },
  "curl": {
    "eth_sendBundle": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' -H 'X-Flashbots-Signature: 0xADDRESS:0xSIG' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_sendBundle\",\"params\":[{\"txs\":[\"0xSIGNED_TX\"],\"blockNumber\":\"0xTARGET_BLOCK\"}]}'",
    "eth_callBundle": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' -H 'X-Flashbots-Signature: 0xADDRESS:0xSIG' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_callBundle\",\"params\":[{\"txs\":[\"0xSIGNED_TX\"],\"blockNumber\":\"0xTARGET_BLOCK\",\"stateBlockNumber\":\"latest\"}]}'",
    "eth_sendPrivateTransaction": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' -H 'X-Flashbots-Signature: 0xADDRESS:0xSIG' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_sendPrivateTransaction\",\"params\":[{\"tx\":\"0xSIGNED_TX\",\"maxBlockNumber\":\"0xTARGET_BLOCK\"}]}'",
    "eth_sendPrivateRawTransaction": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' -H 'X-Flashbots-Signature: 0xADDRESS:0xSIG' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_sendPrivateRawTransaction\",\"params\":[\"0xSIGNED_TX\"]}'",
    "eth_cancelPrivateTransaction": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' -H 'X-Flashbots-Signature: 0xADDRESS:0xSIG' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"eth_cancelPrivateTransaction\",\"params\":[{\"txHash\":\"0xTX_HASH\"}]}'",
    "mev_sendBundle": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"mev_sendBundle\",\"params\":[{\"version\":\"v0.1\",\"inclusion\":{\"block\":\"0xTARGET_BLOCK\",\"maxBlock\":\"0xTARGET_PLUS_2\"},\"body\":[{\"tx\":\"0xSIGNED_TX\",\"canRevert\":false}]}]}'",
    "buildernet_getDelayedRefunds": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"buildernet_getDelayedRefunds\",\"params\":[\"0xYOUR_ADDRESS\"]}'",
    "buildernet_getDelayedRefundTotals": "curl -X POST https://relay.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"buildernet_getDelayedRefundTotalsByRecipient\",\"params\":[\"0xYOUR_ADDRESS\"]}'",
    "protect_send_tx": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "protect_fast_send_tx": "curl -X POST https://rpc.flashbots.net/fast -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "protect_specific_builders": "curl -X POST 'https://rpc.flashbots.net?builder=flashbots&builder=titanbuilder&builder=beaverbuild' -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "protect_with_refund": "curl -X POST 'https://rpc.flashbots.net?refund=0xYOUR_ADDRESS:50' -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "protect_with_mempool_fallback": "curl -X POST 'https://rpc.flashbots.net?useMempool=true' -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "protect_block_range": "curl -X POST 'https://rpc.flashbots.net?blockRange=25' -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_sendRawTransaction\",\"params\":[\"0xSIGNED_TX\"],\"id\":1}'",
    "check_tx_status": "curl https://protect.flashbots.net/tx/0xTX_HASH",
    "eth_blockNumber": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}'",
    "eth_chainId": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":1}'",
    "eth_getBalance": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBalance\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_gasPrice": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":1}'",
    "eth_maxPriorityFeePerGas": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_maxPriorityFeePerGas\",\"params\":[],\"id\":1}'",
    "eth_getTransactionCount": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionCount\",\"params\":[\"0xYOUR_ADDRESS\",\"latest\"],\"id\":1}'",
    "eth_estimateGas": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_estimateGas\",\"params\":[{\"to\":\"0xTO\",\"data\":\"0x\"}],\"id\":1}'",
    "eth_feeHistory": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_feeHistory\",\"params\":[4,\"latest\",[25,75]],\"id\":1}'",
    "eth_getTransactionReceipt": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionReceipt\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getTransactionByHash": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getTransactionByHash\",\"params\":[\"0xTX_HASH\"],\"id\":1}'",
    "eth_getBlockByNumber": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByNumber\",\"params\":[\"latest\",false],\"id\":1}'",
    "eth_getBlockByHash": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getBlockByHash\",\"params\":[\"0xBLOCK_HASH\",false],\"id\":1}'",
    "eth_call": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_call\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC_SELECTOR\"},\"latest\"],\"id\":1}'",
    "eth_getLogs": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getLogs\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_getCode": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getCode\",\"params\":[\"0xCONTRACT\",\"latest\"],\"id\":1}'",
    "eth_getStorageAt": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getStorageAt\",\"params\":[\"0xCONTRACT\",\"0x0\",\"latest\"],\"id\":1}'",
    "eth_syncing": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_syncing\",\"params\":[],\"id\":1}'",
    "eth_newFilter": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newFilter\",\"params\":[{\"fromBlock\":\"latest\",\"toBlock\":\"latest\",\"address\":\"0xCONTRACT\",\"topics\":[]}],\"id\":1}'",
    "eth_newBlockFilter": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newBlockFilter\",\"params\":[],\"id\":1}'",
    "eth_newPendingTransactionFilter": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_newPendingTransactionFilter\",\"params\":[],\"id\":1}'",
    "eth_getFilterChanges": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_getFilterChanges\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_uninstallFilter": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_uninstallFilter\",\"params\":[\"0xFILTER_ID\"],\"id\":1}'",
    "eth_createAccessList": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_createAccessList\",\"params\":[{\"to\":\"0xCONTRACT\",\"data\":\"0xFUNC\"},\"latest\"],\"id\":1}'",
    "net_version": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"net_version\",\"params\":[],\"id\":1}'",
    "web3_clientVersion": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"web3_clientVersion\",\"params\":[],\"id\":1}'",
    "txpool_status": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_status\",\"params\":[],\"id\":1}'",
    "txpool_content": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"txpool_content\",\"params\":[],\"id\":1}'",
    "batch_request": "curl -X POST https://rpc.flashbots.net -H 'Content-Type: application/json' --data '[{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1},{\"jsonrpc\":\"2.0\",\"method\":\"eth_gasPrice\",\"params\":[],\"id\":2},{\"jsonrpc\":\"2.0\",\"method\":\"eth_chainId\",\"params\":[],\"id\":3}]'"
  }
}
