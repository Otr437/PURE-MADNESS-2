{
  "name": "@crypto-monorepo/bot",
  "version": "1.0.0",
  "description": "Autonomous crypto agent — zero npm dependencies, pure Node.js built-ins only",
  "main": "core/agent.js",
  "bin": {
    "crypto-bot": "./bin/run.js"
  },
  "scripts": {
    "start": "node bin/run.js",
    "start:quiet": "node bin/run.js --quiet"
  },
  "dependencies": {
    "@crypto-monorepo/aes-gcm":          "1.0.0",
    "@crypto-monorepo/aes-cbc":          "1.0.0",
    "@crypto-monorepo/rsa-hybrid":       "1.0.0",
    "@crypto-monorepo/ecdh":             "1.0.0",
    "@crypto-monorepo/encrypted-channel":"1.0.0",
    "@crypto-monorepo/key-derivation":   "1.0.0",
    "@crypto-monorepo/signatures":       "1.0.0",
    "@crypto-monorepo/secure-key-store": "1.0.0",
    "@crypto-monorepo/crypto-utils":     "1.0.0",
    "@crypto-monorepo/shared":           "1.0.0"
  },
  "engines": { "node": ">=18.0.0" }
}
