{
  "_meta": {
    "category": "data_services",
    "description": "Market data, news, search, weather, maps, misc data APIs",
    "encrypt": true,
    "hot_swap": true
  },
  "alpha_vantage": {
    "api_key": "YOUR_ALPHA_VANTAGE_API_KEY",
