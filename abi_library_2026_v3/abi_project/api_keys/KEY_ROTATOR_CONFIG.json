{
  "_meta": {
    "name": "API Key Rotator Config",
    "description": "Master config for the hot-swap key rotator bot. Defines which keys are loaded, when they are needed, priority order, encryption status, and swap rules.",
    "version": "1.0.0"
  },

  "encryption": {
    "algorithm": "AES-256-GCM",
    "key_derivation": "PBKDF2-SHA256",
    "iterations": 310000,
    "salt_length": 32,
    "iv_length": 16,
    "master_key_env_var": "ROTATOR_MASTER_KEY",
    "note": "Master key NEVER stored in any file. Must be set as environment variable or fetched from hardware security module."
  },

  "key_groups": {
    "blockchain_rpc": {
      "file": "crypto/blockchain_rpc.json",
      "always_loaded": true,
      "encrypt": true,
      "providers_in_priority_order": ["alchemy", "infura", "quicknode", "ankr", "blast_api", "drpc"],
      "failover": true,
      "hot_swap_on_error_codes": [429, 401, 403, 503],
      "rate_limit_per_minute": 300,
      "rotate_every_days": 30
    },
    "exchange_data": {
      "file": "crypto/exchange_and_data.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["price_check", "market_data", "portfolio_read"],
      "unload_after_seconds": 300,
      "hot_swap_on_error_codes": [429, 401]
    },
    "wallets_web3": {
      "file": "crypto/wallets_and_web3.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["user_auth", "wallet_connect", "onramp"],
      "unload_after_seconds": 600
    },
    "payments": {
      "file": "payments/payment_processors.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["checkout", "subscription", "invoice", "refund"],
      "unload_after_seconds": 60,
      "rotate_every_days": 14,
      "rotation_priority": "CRITICAL"
    },
    "ai_models": {
      "file": "ai/ai_models.json",
      "always_loaded": true,
      "encrypt": true,
      "providers_in_priority_order": ["anthropic", "openai", "groq", "mistral", "openrouter"],
      "failover": true,
      "hot_swap_on_error_codes": [429, 401, 503],
      "cost_threshold_usd": 1.00,
      "rotate_every_days": 60
    },
    "dev_tools": {
      "file": "dev/developer_tools.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["deploy", "ci_cd", "logging", "monitoring"],
      "rotate_every_days": 90
    },
    "google": {
      "file": "google/google_services.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["maps_request", "oauth_login", "sheets_sync", "analytics"],
      "unload_after_seconds": 300
    },
    "email": {
      "file": "email/email_services.json",
      "always_loaded": false,
      "encrypt": true,
      "providers_in_priority_order": ["resend", "sendgrid", "postmark", "mailgun"],
      "failover": true,
      "load_when": ["send_email", "email_verification", "newsletter"],
      "unload_after_seconds": 120
    },
    "social": {
      "file": "social/social_apis.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["post_tweet", "discord_alert", "telegram_notify", "slack_webhook"],
      "unload_after_seconds": 60
    },
    "data_services": {
      "file": "data/data_services.json",
      "always_loaded": false,
      "encrypt": true,
      "load_when": ["sms_send", "ip_lookup", "news_fetch", "weather"],
      "unload_after_seconds": 180
    },
    "infra": {
      "file": "infra/infrastructure.json",
      "always_loaded": true,
      "encrypt": true,
      "rotate_every_days": 7,
      "rotation_priority": "HIGH"
    }
  },

  "hot_swap_rules": {
    "on_rate_limit_429": {
      "action": "swap_to_next_provider",
      "cooldown_seconds": 60,
      "max_retries": 3
    },
    "on_auth_error_401": {
      "action": "swap_to_next_provider_and_alert",
      "alert_channel": "telegram",
      "max_retries": 1
    },
    "on_service_down_503": {
      "action": "swap_to_next_provider",
      "cooldown_seconds": 30,
      "max_retries": 5
    },
    "on_cost_threshold_exceeded": {
      "action": "swap_to_cheaper_provider",
      "providers_by_cost": {
        "ai_models": ["groq", "openrouter", "mistral", "anthropic", "openai"]
      }
    }
  },

  "alerting": {
    "telegram_bot_token_env": "ALERT_TELEGRAM_BOT_TOKEN",
    "telegram_chat_id_env": "ALERT_TELEGRAM_CHAT_ID",
    "slack_webhook_env": "ALERT_SLACK_WEBHOOK",
    "alert_on": [
      "key_rotation_complete",
      "key_swap_triggered",
      "auth_error_401",
      "all_providers_exhausted",
      "cost_threshold_exceeded",
      "rotation_failed"
    ]
  },

  "storage": {
    "encrypted_keys_path": "./encrypted/",
    "note": "Encrypted key files stored here — safe to commit if master key is secret",
    "backup_path": "./encrypted_backup/",
    "in_memory_only": false,
    "redis_cache": true,
    "redis_ttl_seconds": 3600
  },

  "audit_log": {
    "enabled": true,
    "log_path": "./audit/key_rotator.log",
    "log_level": "INFO",
    "log_events": ["load", "unload", "swap", "rotate", "error", "alert"],
    "redact_key_values": true
  }
}
