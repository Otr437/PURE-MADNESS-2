{
  "_meta": {
    "name": "dYdX V4 — sovereign Cosmos app-chain, fully onchain CLOB orderbook, 200+ perp markets",
    "architecture": "Cosmos SDK + CometBFT L1. Off-chain in-memory orderbook (not EVM). REST + WebSocket + gRPC. Orders gossiped to validators, fills committed onchain.",
    "endpoints": {
      "mainnet_api":       "https://indexer.dydx.trade/v4",
      "mainnet_node":      "https://dydx-mainnet-full-cosmos.public.blastapi.io",
      "mainnet_faucet":    "N/A (mainnet)",
      "testnet_api":       "https://indexer.v4testnet.dydx.exchange/v4",
      "testnet_node":      "https://dydx-testnet-full-cosmos.public.blastapi.io",
      "chain_id_mainnet":  "dydx-mainnet-1",
      "chain_id_testnet":  "dydx-testnet-4",
      "explorer":          "https://www.mintscan.io/dydx"
    },
    "tokens": {
      "DYDX_ethereum":    "0x92D6C1e31e14520e676a687F0a93788B716BEff5",
      "DYDX_dydxchain":   "adydx (native denom, 1 DYDX = 1e18 adydx)",
      "USDC_dydxchain":   "ibc/8E27BA2D5493AF5636760E354E46004562C46AB7EC0CC4C1CA14E9E20E2545B5",
      "note": "Collateral is USDC bridged via Noble chain (IBC)"
    },
    "market_specs": {
      "settlement": "USDC collateral, all positions settled in USDC",
      "leverage_max": "20x (market dependent)",
      "order_types": ["MARKET", "LIMIT", "STOP_LIMIT", "TAKE_PROFIT_LIMIT", "STOP_MARKET", "TAKE_PROFIT_MARKET"],
      "time_in_force": ["GTT (Good Til Time)", "FOK (Fill or Kill)", "IOC (Immediate or Cancel)"],
      "fees_maker": "0.01%",
      "fees_taker": "0.05%"
    }
  },
  "rest_endpoints": {
    "get_markets":          "GET /v4/perpetualMarkets",
    "get_market":           "GET /v4/perpetualMarkets/{ticker}",
    "get_orderbook":        "GET /v4/orderbooks/perpetualMarket/{ticker}",
    "get_trades":           "GET /v4/trades/perpetualMarket/{ticker}",
    "get_candles":          "GET /v4/candles/perpetualMarkets/{ticker}?resolution=1MIN",
    "get_account":          "GET /v4/addresses/{address}",
    "get_subaccount":       "GET /v4/addresses/{address}/subaccountNumber/{subaccountNumber}",
    "get_positions":        "GET /v4/perpetualPositions?address={address}&subaccountNumber={n}&status=OPEN",
    "get_orders":           "GET /v4/orders?address={address}&subaccountNumber={n}&status=OPEN",
    "get_order":            "GET /v4/orders/{orderId}",
    "get_fills":            "GET /v4/fills?address={address}&subaccountNumber={n}",
    "get_historical_pnl":   "GET /v4/historical-pnl?address={address}&subaccountNumber={n}",
    "get_transfers":        "GET /v4/transfers?address={address}&subaccountNumber={n}",
    "get_height":           "GET /v4/height",
    "get_time":             "GET /v4/time",
    "get_validator_status": "GET /v4/screen?address={address}"
  },
  "cosmos_messages": {
    "note": "Transactions broadcast via Cosmos SDK tx format, signed with secp256k1 private key",
    "place_order": {
      "type": "dydxprotocol.clob.MsgPlaceOrder",
      "fields": {
        "order": {
          "orderId": {"subaccountId": {"owner": "dydx1...", "number": 0}, "clientId": 12345, "orderFlags": 0, "clobPairId": 0},
          "side": "SIDE_BUY or SIDE_SELL",
          "quantums": "size * atomicResolution (see market params)",
          "subticks": "price * quantumConversionExponent",
          "goodTilBlock": "current_block + N (short-term orders only)",
          "goodTilBlockTime": "unix timestamp (long-term orders, flags=64)",
          "timeInForce": "TIME_IN_FORCE_UNSPECIFIED|FILL_OR_KILL|POST_ONLY|IOC",
          "reduceOnly": false,
          "clientMetadata": 0
        }
      }
    },
    "cancel_order": {
      "type": "dydxprotocol.clob.MsgCancelOrder",
      "fields": {"orderId": {"subaccountId": {}, "clientId": 0, "orderFlags": 0, "clobPairId": 0}, "goodTilBlock": 0}
    },
    "deposit": {
      "type": "dydxprotocol.bridge.MsgAcknowledgeBridges",
      "note": "Use the official bridge from Ethereum — send USDC to Noble chain via IBC, then to dYdX"
    }
  },
  "websocket": {
    "url": "wss://indexer.dydx.trade/v4/ws",
    "subscriptions": {
      "markets":     {"type": "subscribe", "channel": "v4_markets", "id": "0"},
      "orderbook":   {"type": "subscribe", "channel": "v4_orderbook", "id": "BTC-USD"},
      "trades":      {"type": "subscribe", "channel": "v4_trades", "id": "BTC-USD"},
      "candles":     {"type": "subscribe", "channel": "v4_candles", "id": "BTC-USD/1MIN"},
      "subaccount":  {"type": "subscribe", "channel": "v4_subaccounts", "id": "dydx1.../0"}
    }
  },
  "sdks": {
    "typescript": "npm install @dydxprotocol/v4-client-js",
    "python":     "pip install v4-client-py",
    "github":     "github.com/dydxprotocol/v4-chain"
  }
}
