{
  "name": "rag-ai-typescript",
  "version": "2.0.0",
  "description": "RAG AI system — TypeScript production implementation",
  "main": "dist/rag_agent.js",
  "scripts": {
    "build":       "tsc",
    "rag-agent":   "ts-node src/rag_agent.ts",
    "react-agent": "ts-node src/run_agent.ts",
    "eval":        "ts-node src/eval_harness.ts",
    "api":         "ts-node src/rag_api.ts",
    "test":        "jest --forceExit --testPathPattern=tests/"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "transform": { "^.+\\.tsx?$": "ts-jest" }
  },
  "dependencies": {
    "@anthropic-ai/sdk":       "0.104.1",
    "@qdrant/js-client-rest":  "1.18.0",
    "openai":                  "4.104.0",
    "mammoth":                 "1.9.1",
    "marked":                  "14.1.2",
    "pdf-parse":               "1.1.1",
    "express":                 "4.21.2",
    "express-rate-limit":      "7.5.0",
    "jsonwebtoken":            "9.0.2",
    "pino":                    "9.6.0",
    "zod":                     "3.24.2"
  },
  "devDependencies": {
    "@types/express":          "4.17.21",
    "@types/jsonwebtoken":     "9.0.7",
    "@types/mammoth":          "1.6.0",
    "@types/node":             "22.10.1",
    "@types/pdf-parse":        "1.1.4",
    "ts-node":                 "10.9.2",
    "typescript":              "5.7.2",
    "jest":                    "29.7.0",
    "ts-jest":                 "29.2.5",
    "@types/jest":             "29.5.14"
  },
  "engines": { "node": ">=20.0.0" }
}
