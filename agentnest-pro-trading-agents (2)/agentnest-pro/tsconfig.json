{
  "compilerOptions": {
    "target":           "ES2022",
    "lib":              ["ES2022"],
    "module":           "ESNext",
    "moduleResolution": "Bundler",
    "strict":           true,
    "skipLibCheck":     true,
    "esModuleInterop":  true,
    "resolveJsonModule": true,
    "outDir":           "./dist-server"
  },
  "include": ["server"],
  "exclude": ["node_modules", "dist-server"]
}
