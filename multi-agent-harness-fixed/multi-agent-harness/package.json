{
  "name": "multi-agent-harness",
  "version": "1.0.0",
  "description": "Multi-provider parallel agent harness: Claude, OpenAI, Groq, DeepSeek",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start":           "tsx src/index.ts",
    "run:fanout":      "tsx src/index.ts",
    "run:stream":      "tsx src/run-stream.ts",
    "run:tools":       "tsx src/run-tools.ts",
    "run:production":  "tsx src/run-production.ts",
    "run:orchestrate": "tsx src/run-orchestrate.ts",
    "browser":         "tsx src/run-browser.ts"
  },
  "dependencies": {
    "playwright":        "^1.44.0",
    "ethers":            "^6.0.0",
    "bitcoinjs-lib":     "^7.0.0",
    "ecpair":            "^2.1.0",
    "tiny-secp256k1":    "^2.2.3",
    "bip32":             "^4.0.0",
    "bip39":             "^3.1.0",
    "ai":                "^4.3.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai":    "^1.0.0",
    "@ai-sdk/groq":      "^1.0.0",
    "@ai-sdk/deepseek":  "^0.2.0",
    "dotenv":            "^16.0.0",
    "zod":               "^3.0.0"
  },
  "devDependencies": {
    "tsx":          "^4.0.0",
    "typescript":   "^5.0.0",
    "@types/node":  "^20.0.0"
  }
}
