## PART 8 — SCRIPT STRUCTURE TEMPLATE (Complete)

```powershell
#Requires -Version 7.6
#Requires -PSEdition Core
<#
.SYNOPSIS
    <One-line purpose>
.DESCRIPTION
    <Full description>
.PARAMETER InputPath
    Path to the input file or directory.
.PARAMETER OutputPath
    Path where output will be written.
.PARAMETER Force
    Overwrite existing output without prompting.
.EXAMPLE
    .\Process-Data.ps1 -InputPath C:\data -OutputPath C:\out
    Processes all files in C:\data and writes results to C:\out.
.EXAMPLE
    .\Process-Data.ps1 -InputPath C:\data -OutputPath C:\out -Force
    Same but overwrites existing output without confirmation.
.NOTES
    Author:     Your Name
    Created:    2026-06-02
    Version:    1.0.0
    PS Version: 7.6.2 LTS (.NET 10)
#>
[CmdletBinding(SupportsShouldProcess, ConfirmImpact = 'Medium')]
param(
    [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
    [ValidateScript({ Test-Path $_ })]
    [string] $InputPath,

    [Parameter(Mandatory)]
    [string] $OutputPath,

    [switch] $Force
)

begin {
    Set-StrictMode -Version Latest
    $ErrorActionPreference = 'Stop'

    # Respect NO_COLOR for CI/logging environments
    if ($env:NO_COLOR) {
        $PSStyle.OutputRendering = [System.Management.Automation.OutputRendering]::PlainText
    }

    Write-Verbose "Starting $(Split-Path $PSCommandPath -Leaf) on PS $($PSVersionTable.PSVersion)"
}

process {
    try {
        if ($PSCmdlet.ShouldProcess($InputPath, 'Process')) {
            # Main logic here

            # Modern array intrinsics (7.6)
            $items = Get-ChildItem $InputPath -File
            $largeFiles = $items.PSWhere({ $_.Length -gt 1MB })
            $names      = $largeFiles.PSForEach({ $_.Name })

            # Parallel processing
            $results = $largeFiles | ForEach-Object -Parallel {
                # work per file
                [PSCustomObject]@{
                    File = $_.Name
                    Size = $_.Length
                }
            } -ThrottleLimit 8

            $results | Export-Csv (Join-Path $OutputPath 'results.csv') -NoTypeInformation
        }
    }
    catch [System.UnauthorizedAccessException] {
        Write-Warning "Access denied: $InputPath"
    }
    catch {
        Write-Error "Failed processing '$InputPath': $_"
        throw
    }
}

end {
    Write-Verbose "Completed."
}
```

